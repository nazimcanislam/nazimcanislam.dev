---
import Header from "@layout/Header.astro";
import Footer from "@layout/Footer.astro";
import CommandPalette from "@ui/CommandPalette.astro";
import BubbleBackgroundCanvas from "@sections/BubbleBackgroundCanvas.astro";
import NoScript from "@layout/NoScript.astro";
import StructuredData from "@/components/data/StructuredData.astro";
import {
  getLang,
  useTranslations,
  localizePath,
  stripLocale,
} from "@i18n/utils";
import "@styles/base.css";
import "@styles/typography.css";
import "@styles/utilities.css";
import { profile } from "@data/profile";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  heroPreload?: string;
  schema?: object;
}

const lang = getLang(Astro);
const t = useTranslations(lang);

// hreflang alternatifleri için bu sayfanın her iki dildeki URL'si.
const basePath = stripLocale(Astro.url.pathname);
const enUrl = new URL(localizePath(basePath, "en"), Astro.site).href;
const trUrl = new URL(localizePath(basePath, "tr"), Astro.site).href;

// fallbackType: "rewrite" altında canonical/og:url'yi dile göre doğru URL'den türetiyoruz.
const canonicalUrl = lang === "tr" ? trUrl : enUrl;
const ogImage = new URL("/og-image.jpg", Astro.site).href;

const {
  title = t("meta", "title"),
  description = t("meta", "description"),
  heroPreload,
  schema,
} = Astro.props;
---

<!doctype html>
<html lang={lang} style="color-scheme: dark light;">
  <head>
    <!-- Karakter kodlaması: <head>'in ilk öğesi olmalı (ilk 1024 bayt içinde). -->
    <meta charset="UTF-8" />

    <meta name="color-scheme" content="dark light" />

    <!--
      Dil otomatik tespiti (boyama öncesi çalışması için is:inline olarak <head> en üstünde tutulur).
    -->
    <script is:inline>
      (function () {
        try {
          var path = location.pathname;
          var stored = null;
          try {
            stored = localStorage.getItem("preferred-lang");
          } catch (e) {}
          var nav = (navigator.language || "en").slice(0, 2).toLowerCase();
          var want = stored || (nav === "tr" ? "tr" : "en");
          if (want !== "tr" && want !== "en") want = "en";
          var isTr = path === "/tr" || path.indexOf("/tr/") === 0;
          var curr = isTr ? "tr" : "en";
          if (want === curr) return;
          var base = isTr ? (path === "/tr" ? "/" : path.slice(3)) : path;
          var target =
            want === "tr" ? (base === "/" ? "/tr" : "/tr" + base) : base;
          if (target !== path)
            location.replace(target + location.search + location.hash);
        } catch (e) {}
      })();
    </script>

    <!-- Meta tags -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {
      heroPreload && (
        <link
          rel="preload"
          as="image"
          href={heroPreload}
          type="image/avif"
          fetchpriority="high"
        />
      )
    }
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />

    <title>{title}</title>

    <!-- Theme color -->
    <meta
      name="theme-color"
      content="#2563eb"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#3b82f6"
      media="(prefers-color-scheme: dark)"
    />

    <!-- Open Graph -->
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nazımcan İslam" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="A preview for Nazımcan İslam's portfolio web site"
    />
    <meta property="og:locale" content={lang === "tr" ? "tr_TR" : "en_US"} />
    <meta
      property="og:locale:alternate"
      content={lang === "tr" ? "en_US" : "tr_TR"}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content="nazimcanislam-dev.vercel.app" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- hreflang alternates -->
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="tr" href={trUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <!-- Favicon and web manifest -->
    <link
      rel="icon"
      type="image/png"
      href="/favicon/favicon-96x96.png"
      sizes="96x96"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="shortcut icon" href="/favicon/favicon.ico" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/favicon/apple-touch-icon.png"
    />
    <meta name="apple-mobile-web-app-title" content="ni.dev" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <StructuredData
      schema={schema ?? {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Person",
            "@id": `${profile.url}/#person`,
            name: profile.name,
            url: profile.url,
            jobTitle: profile.role,
            description: t("home", "bio"),
            knowsAbout: Object.values(profile.skills).flat(),
            sameAs: profile.sameAs,
          },
          {
            "@type": "WebSite",
            "@id": `${profile.url}/#website`,
            url: profile.url,
            name: title,
            description: description,
            inLanguage: lang,
            publisher: {
              "@id": `${profile.url}/#person`,
            },
          },
        ],
      }}
    />

    <!-- Samsung Internet ClientRouter scrollend workaround (ClientRouter öncesi senkron çalışmalı) -->
    <script is:inline>
      if (/SamsungBrowser/i.test(navigator.userAgent)) {
        addEventListener("scrollend", function (e) {
          e.stopImmediatePropagation();
        });
      }
    </script>

    <ClientRouter />
  </head>
  <body>
    <a href="#main-content" class="skip-link">
      {t("shared", "skip_to_main_content")}
    </a>
    <Header />
    <NoScript />
    <main id="main-content">
      <BubbleBackgroundCanvas />
      <slot />
    </main>
    <Footer />
    <CommandPalette />
    <script>
      import "@scripts/layout/console-greeting";
    </script>
  </body>
</html>
