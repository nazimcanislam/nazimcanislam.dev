---
import Header from "@layout/Header.astro";
import Footer from "@layout/Footer.astro";
import BubbleBackgroundCanvas from "@/components/sections/BubbleBackgroundCanvas.astro";
import NoScript from "@/components/layout/NoScript.astro";
import {
  getLang,
  useTranslations,
  localizePath,
  stripLocale,
} from "@/i18n/utils";
import "@styles/base.css";
import "@styles/typography.css";
import "@styles/utilities.css";

interface Props {
  title?: string;
  description?: string;
}

const lang = getLang(Astro);
const t = useTranslations(lang);

// hreflang alternatifleri için bu sayfanın her iki dildeki URL'si.
const basePath = stripLocale(Astro.url.pathname);
const enUrl = new URL(localizePath(basePath, "en"), Astro.site).href;
const trUrl = new URL(localizePath(basePath, "tr"), Astro.site).href;

const { title = t("meta", "title"), description = t("meta", "description") } =
  Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <!--
      Dil otomatik tespiti (cold-start YOK; bu istemci tarafında çalışır).
      İlk ziyarette tarayıcı diline göre, sonraki ziyaretlerde kaydedilmiş
      tercihe göre doğru dile yönlendirir. Boyama öncesi çalışsın diye en üstte.
    -->
    <script is:inline>
      (function () {
        try {
          var path = location.pathname;
          var stored = null;
          try {
            stored = localStorage.getItem("preferred-lang");
          } catch (e) {}
          var nav = (navigator.language || "en").slice(0, 2).toLowerCase();
          var want = stored || (nav === "tr" ? "tr" : "en");
          if (want !== "tr" && want !== "en") want = "en";
          var isTr = path === "/tr" || path.indexOf("/tr/") === 0;
          var curr = isTr ? "tr" : "en";
          if (want === curr) return;
          var base = isTr ? (path === "/tr" ? "/" : path.slice(3)) : path;
          var target =
            want === "tr" ? (base === "/" ? "/tr" : "/tr" + base) : base;
          if (target !== path)
            location.replace(target + location.search + location.hash);
        } catch (e) {}
      })();
    </script>

    <!-- Meta tags -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />

    <title>{title}</title>

    <!-- Theme color -->
    <meta
      name="theme-color"
      content="#2563eb"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#3b82f6"
      media="(prefers-color-scheme: dark)"
    />

    <!-- Open Graph  -->
    <meta
      property="og:url"
      content={new URL(Astro.url.pathname, Astro.site).href}
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content={new URL(Astro.url.pathname, Astro.site).href + "og-image.jpg"}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content="nazimcanislam-dev.vercel.app" />
    <meta
      property="twitter:url"
      content={new URL(Astro.url.pathname, Astro.site).href}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={new URL(Astro.url.pathname, Astro.site).href + "og-image.jpg"}
    />

    <!-- Canonical URL -->
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />

    <!-- hreflang alternates (çok dilli SEO) -->
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="tr" href={trUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <!-- Favicon and web manifest -->
    <link
      rel="icon"
      type="image/png"
      href="/favicon/favicon-96x96.png"
      sizes="96x96"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="shortcut icon" href="/favicon/favicon.ico" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/favicon/apple-touch-icon.png"
    />
    <meta name="apple-mobile-web-app-title" content="ni.dev" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <a href="#main-content" class="skip-link"
      >{t("shared", "skip_to_main_content")}</a
    >
    <Header />
    <NoScript />
    <main id="main-content">
      <BubbleBackgroundCanvas />
      <slot />
    </main>
    <Footer />
  </body>
</html>
