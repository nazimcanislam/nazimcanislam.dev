---
import { usesData } from '../data/uses';
import { getLang, useTranslations } from '@/i18n/utils';
import PageCommand from '@/components/ui/PageCommand.astro';
import Layout from '../layouts/Layout.astro';
import "@styles/pages/uses.css";

const lang = getLang(Astro);
const t = useTranslations(lang);

const pageTitle = t("uses", "meta_title");
const pageDescription = t("uses", "meta_subtitle");
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="uses-page">
    <div class="uses-page-wrapper">
      <header class="uses-hero">
        <PageCommand pageTitle={t("uses", "uses_title")} command="neofetch" />

        <h1 class="uses-hero-title">
          {t("uses", "uses_title")}<span class="dot" aria-hidden="true">.</span>
        </h1>
        <p class="uses-hero-subtitle">
          {"> "}
          {t("uses", "hero_subtitle")}
        </p>
      </header>

      <div class="categories-section">
        {usesData.map((category, index) => (
          <section id={category.id} class="category-item" style={`animation-delay: ${0.3 * index}s`}>
            <a href={`#${category.id}`} class="section-label">
              <h2>{category.title[lang]}</h2>
            </a>

            <div class="items-grid">
              {category.items.map((item) => (
                <div class="item">
                  <h3 class="item-heading">
                    {item.link ? (
                      <a
                        class="item-link"
                        href={item.link} 
                        target="_blank" 
                        rel="noopener noreferrer" 
                        title={`${item.title} sitesine git`}
                        aria-label={`${item.title} bağlantısını yeni sekmede aç`}
                      >
                        {item.emoji} {item.title}
                      </a>
                    ) : 
                      <span>{item.emoji} {item.title}</span>
                    }
                  </h3>
                  
                  <p class="item-desc">
                    {item.description[lang]}
                  </p>
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </div>
</Layout>
