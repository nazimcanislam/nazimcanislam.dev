---
import { usesData } from '../data/uses';
import { getLang, useTranslations } from '@/i18n/utils';
import PageCommand from '@/components/ui/PageCommand.astro';
import Layout from '../layouts/Layout.astro';

const lang = getLang(Astro);
const t = useTranslations(lang);

const pageTitle = t("uses", "meta_title");
const pageDescription = t("uses", "meta_subtitle");
---

<style>
  .uses-page {
    max-width: 100%;
    width: 100%;
    padding: 64px 16px;
  }

  .uses-page-wrapper {
    max-width: 1024px;
    margin-inline: auto;
  }

  .uses-hero {
    margin-bottom: 48px;
  }

  .uses-hero-title {
    font-size: clamp(2.2rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 12px;
    color: var(--color-text-primary);
  }
  .uses-hero-title .dot {
    color: var(--color-accent);
  }

  .uses-hero-subtitle {
    font-family: ui-monospace, monospace;
    font-size: 1rem;
    color: var(--color-accent);
    margin: 0;
    opacity: 0.9;
  }

  .section-label {
    display: inline-flex;
    align-items: center;
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    letter-spacing: 0.08em;
    margin-bottom: 8px;
    padding: 5px 12px;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    text-decoration: none;
    transition: transform 200ms ease;

    h2 {
      font-size: inherit;
      margin: 0;
    }

    &:hover {
      transform: translateY(-2px)
    }

    &::before {
      content: "# ";
      color: var(--color-accent);
      font-weight: 600;
    }
  }

  .category-item {
    background-color: var(--color-glass-bg);
    padding: 24px;
    border: 1px solid var(--color-glass-border);
    border-radius: var(--border-radius-for-section);
    margin-bottom: 24px;
  }

  .items-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    grid-auto-rows: 1fr;
    gap: 24px;
  }

  .item {
    .item-heading {
      max-width: max-content;
      font-size: clamp(0.875rem, 2.5vw, 1rem);

      &:hover {
        .item-link {
          color: var(--color-accent);
        }
      }
      
      .item-link {
        text-decoration: none;
        color: var(--color-text-primary);
        transition: color 200ms ease;
        
        &::after {
          content: "↗";
          margin-left: 8px;
          color: var(--color-text-secondary);
        }
      }
    }

    .item-desc {
      font-size: clamp(0.75rem, 2.5vw, 0.8125rem);
      margin: 0;
    }
  }

  .categories-item {
    animation: fadeUp 0.5s ease both;
  }
</style>

<Layout title={pageTitle} description={pageDescription}>
  <div class="uses-page">
    <div class="uses-page-wrapper">
      <header class="uses-hero">
        <PageCommand pageTitle={t("uses", "uses_title")} command="neofetch" />

        <h1 class="uses-hero-title">
          {t("uses", "uses_title")}<span class="dot" aria-hidden="true">.</span>
        </h1>
        <p class="uses-hero-subtitle">
          {"> "}
          {t("uses", "hero_subtitle")}
        </p>
      </header>

      <div class="categories-section">
        {usesData.map((category, index) => (
          <section id={category.id} class="category-item" style={`animation-delay: ${0.3 * index}s`}>
            <a href={`#${category.id}`} class="section-label">
              <h2>{category.title[lang]}</h2>
            </a>

            <div class="items-grid">
              {category.items.map((item) => (
                <div class="item">
                  <h3 class="item-heading">
                    {item.link ? (
                      <a
                        class="item-link"
                        href={item.link} 
                        target="_blank" 
                        rel="noopener noreferrer" 
                        title={`${item.title} sitesine git`}
                        aria-label={`${item.title} bağlantısını yeni sekmede aç`}
                      >
                        {item.emoji} {item.title}
                      </a>
                    ) : 
                      <span>{item.emoji} {item.title}</span>
                    }
                  </h3>
                  
                  <p class="item-desc">
                    {item.description[lang]}
                  </p>
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </div>
</Layout>
