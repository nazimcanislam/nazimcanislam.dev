---
import "@styles/pages/blog-post.css";
import Layout from "@/layouts/Layout.astro";
import PageShell from "@layout/PageShell.astro";
import PostMeta from "@/components/blog/PostMeta.astro";
import { getLang, useTranslations, localizePath } from "@i18n/utils";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<"blog"> };

const lang = getLang(Astro);
const t = useTranslations(lang);

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout
  title={`${post.data.title} — Nazımcan İslam`}
  description={post.data.description}
>
  <PageShell narrow>
    <article>
      <a href={localizePath("/blog", lang)} class="post-back">
        {t("blog", "back_to_blog")}
      </a>

      <header class="post-header">
        <PostMeta
          date={post.data.pubDate}
          lang={lang}
          tags={post.data.tags}
        />
        <h1 class="post-title">{post.data.title}</h1>
        <p class="post-desc">{post.data.description}</p>
      </header>

      <hr class="post-divider" />

      <div class="post-content">
        <Content />
      </div>
    </article>
  </PageShell>
</Layout>
