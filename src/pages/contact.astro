---
import "@styles/pages/contact.css";
import Layout from "@/layouts/Layout.astro";
import PageShell from "@layout/PageShell.astro";
import SectionHeader from "@layout/SectionHeader.astro";
import SectionLabel from "@ui/SectionLabel.astro";
import StatusPill from "@ui/StatusPill.astro";
import { Icon } from "astro-icon/components";
import { profile } from "@data/profile";
import { SOCIAL_LINKS } from "@constants/navigation";
import { getLang, useTranslations } from "@i18n/utils";

const lang = getLang(Astro);
const t = useTranslations(lang);

const channelOrder = ["email", "github", "linkedin", "instagram"] as const;
const channels = channelOrder.map((key) => {
  const link = SOCIAL_LINKS.find((item) => item.key === key)!;
  return {
    ...link,
    label: t("contact", `${key}_label`),
    note: t("contact", `${key}_note`),
  };
});
---

<Layout
  title={t("contact", "meta_title")}
  description={t("contact", "meta_desc")}
>
  <PageShell>
    <SectionHeader
      dirName={t("contact", "hero_label")}
      pageHeading={t("contact", "hero_title")}
      subHeading={t("contact", "hero_subtitle")}
      command="ping"
    />

    <div class="contact-body">
      <div class="contact-status-wrap">
        <StatusPill
          variant="success"
          ariaLabel={profile.work.isEmployed
            ? profile.work.statusLabel[lang]
            : "Status: open to work"}
        >
          {
            profile.work.isEmployed
              ? `${profile.work.statusLabel[lang]} — ${profile.work.statusNote[lang]}`
              : `${t("contact", "open_to")} — ${t("contact", "open_to_note")}`
          }
        </StatusPill>
      </div>

      <SectionLabel label={t("contact", "section_channels")} />

      <ul class="channels-list">
        {
          channels.map((ch) => (
            <li>
              <a
                href={ch.href}
                class="channel-card"
                target={ch.external ? "_blank" : undefined}
                rel={ch.external ? "noopener noreferrer" : undefined}
                aria-label={`${ch.label}: ${ch.value}`}
              >
                <div class="channel-icon-wrap" aria-hidden="true">
                  <Icon name={ch.icon} />
                </div>
                <div class="channel-info">
                  <p class="channel-label">{ch.label}</p>
                  <p class="channel-value" translate="no">
                    {ch.value}
                  </p>
                  <p class="channel-note">{ch.note}</p>
                </div>

                <span class="channel-arrow">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </PageShell>
</Layout>
