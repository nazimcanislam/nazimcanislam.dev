---
import Layout from "../layouts/Layout.astro";
import { getLang, useTranslations } from "@/i18n/utils";
import { SOCIAL_LINKS } from "@/components/constants/navigation";
import { Icon } from "astro-icon/components";
import PageCommand from "@/components/ui/PageCommand.astro";

const lang = getLang(Astro.request);
const t = useTranslations(lang);

const channels = [
  {
    key: "email",
    label: t("contact", "email_label"),
    note: t("contact", "email_note"),
    href: "mailto:nazimcanislam@gmail.com",
    value: "nazimcanislam@gmail.com",
    icon: "mdi:email",
  },
  {
    key: "github",
    label: t("contact", "github_label"),
    note: t("contact", "github_note"),
    href: "https://github.com/nazimcanislam",
    value: "github.com/nazimcanislam",
    icon: "mdi:github",
  },
  {
    key: "linkedin",
    label: t("contact", "linkedin_label"),
    note: t("contact", "linkedin_note"),
    href: "https://linkedin.com/in/nazimcanislam",
    value: "linkedin.com/in/nazimcanislam",
    icon: "mdi:linkedin",
  },
  {
    key: "instagram",
    label: t("contact", "instagram_label"),
    note: t("contact", "instagram_note"),
    href: "https://instagram.com/nazimcanislam",
    value: "instagram.com/nazimcanislam",
    icon: "mdi:instagram",
  },
];
---

<style>
  .contact-page {
    max-width: 100%;
    width: 100%;
    padding: 64px 16px;
  }

  .contact-page-wrapper {
    max-width: 1024px;
    margin-inline: auto;
  }

  .contact-hero {
    margin-bottom: 56px;
  }

  .contact-hero-title {
    font-size: clamp(2.2rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 12px;
    color: var(--color-text-primary);
  }
  .contact-hero-title .dot {
    color: var(--color-accent);
  }

  .contact-hero-subtitle {
    font-family: ui-monospace, monospace;
    font-size: 1rem;
    color: var(--color-accent);
    margin: 0;
    opacity: 0.9;
    max-width: 520px;
    line-height: 1.6;
  }

  .contact-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    color: var(--color-code-green-text);
    background: var(--color-code-green-background);
    border: 1px solid var(--color-code-green-border);
    border-radius: 20px;
    padding: 4px 12px;
    margin-bottom: 24px;
  }
  .contact-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 6px currentColor;
    flex-shrink: 0;
  }

  .section-label {
    display: inline-flex;
    align-items: center;
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    letter-spacing: 0.08em;
    margin-bottom: 24px;
    padding: 5px 12px;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 20px;
  }
  .section-label::before {
    content: "# ";
    color: var(--color-accent);
    font-weight: 600;
  }

  .channels-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .channel-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 24px;
    background: var(--color-glass-bg);
    border: 1px solid var(--color-glass-border);
    border-radius: 16px;
    text-decoration: none;
    filter: drop-shadow(0 4px 16px rgba(0, 0, 0, 0.1));
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }
  .channel-card:hover {
    transform: translateX(4px);
    border-color: rgba(var(--color-accent-rgb), 0.4);
  }
  .channel-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .channel-icon-wrap {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(var(--color-accent-rgb), 0.08);
    border: 1px solid rgba(var(--color-accent-rgb), 0.2);
    border-radius: 12px;
    color: var(--color-accent);
    flex-shrink: 0;
    font-size: 1.4rem;
  }

  .channel-info {
    flex: 1;
    min-width: 0;
  }
  .channel-label {
    font-size: 0.75rem;
    font-family: ui-monospace, monospace;
    color: var(--color-text-secondary);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin: 0 0 2px;
  }
  .channel-value {
    font-family: ui-monospace, monospace;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-text-primary);
    margin: 0 0 4px;
    word-break: break-all;
  }
  .channel-note {
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.4;
  }

  .channel-arrow {
    color: var(--color-text-secondary);
    opacity: 0.5;
    flex-shrink: 0;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }
  .channel-card:hover .channel-arrow {
    opacity: 1;
    transform: translateX(2px);
    color: var(--color-accent);
  }

  .contact-body {
    animation: fadeUp 0.6s ease both;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 500px) {
    .channel-card {
      padding: 16px;
    }
    .contact-page {
      padding: 40px 16px;
    }
  }
</style>

<Layout
  title={t("contact", "meta_title")}
  description={t("contact", "meta_desc")}
>
  <div class="contact-page">
    <div class="contact-page-wrapper">
      <header class="contact-hero">
        <PageCommand pageTitle={t("contact", "hero_title")} command="ping" />

        <div class="contact-status" aria-label="Status: open to work">
          <span class="contact-status-dot" aria-hidden="true"></span>
          {t("contact", "open_to")} — {t("contact", "open_to_note")}
        </div>

        <h1 class="contact-hero-title">
          {t("contact", "hero_title")}<span class="dot" aria-hidden="true"
            >.</span
          >
        </h1>
        <p class="contact-hero-subtitle">
          {">"}
          {t("contact", "hero_subtitle")}
        </p>
      </header>

      <div class="contact-body">
        <div class="section-label" aria-hidden="true">
          {t("contact", "section_channels")}
        </div>

        <ul class="channels-list">
          {
            channels.map((ch) => (
              <li>
                <a
                  href={ch.href}
                  class="channel-card"
                  target={ch.href.startsWith("mailto") ? undefined : "_blank"}
                  rel={
                    ch.href.startsWith("mailto")
                      ? undefined
                      : "noopener noreferrer"
                  }
                  aria-label={`${ch.label}: ${ch.value}`}
                >
                  <div class="channel-icon-wrap" aria-hidden="true">
                    <Icon name={ch.icon} />
                  </div>
                  <div class="channel-info">
                    <p class="channel-label">{ch.label}</p>
                    <p class="channel-value" translate="no">
                      {ch.value}
                    </p>
                    <p class="channel-note">{ch.note}</p>
                  </div>
                  <svg
                    class="channel-arrow"
                    width="16"
                    height="16"
                    viewBox="0 0 16 16"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M3 8h10M9 4l4 4-4 4"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</Layout>
