---
import "@styles/pages/about.css";
import Layout from "@/layouts/Layout.astro";
import PageShell from "@layout/PageShell.astro";
import SectionHeader from "@layout/SectionHeader.astro";
import CareerTimeline from "@sections/CareerTimeline.astro";
import Button from "@ui/Button.astro";
import SectionLabel from "@ui/SectionLabel.astro";
import StatusPill from "@ui/StatusPill.astro";
import { profile } from "@data/profile";
import { getLang, useTranslations, localizePath } from "@i18n/utils";

const lang = getLang(Astro);
const t = useTranslations(lang);

const { skills, interests, work } = profile;

const personalData = {
  fileName: "personal.json",
  fileData: {
    name: profile.name,
    location: profile.location[lang],
    role: profile.role[lang],
    languages: profile.spokenLanguages,
    open_to_work: !work.isEmployed,
  },
};
const jsonString = JSON.stringify(personalData.fileData, null, 2);
const byteSize = Buffer.byteLength(jsonString, "utf-8");

const formatValue = (val: unknown) =>
  typeof val === "string" ? `"${val}"` : JSON.stringify(val);

const skillGroups = [
  { label: t("about", "skills_languages"), items: skills.languages },
  { label: t("about", "skills_frameworks"), items: skills.frameworks },
  { label: t("about", "skills_tools"), items: skills.tools },
  {
    label: t("about", "skills_learning"),
    items: skills.learning,
    learning: true,
  },
];
---

<Layout title={t("about", "meta_title")} description={t("about", "meta_desc")}>
  <PageShell>
    <!-- <article> signals to reader mode parsers that this is primary content -->
    <article>
      <SectionHeader
        dirName={t("about", "hero_label")}
        pageHeading={t("about", "hero_title")}
        subHeading={t("about", "hero_subtitle")}
        command="whoami"
      />

      <section class="about-section" aria-label={t("about", "section_whoami")}>
        <SectionLabel label={t("about", "section_whoami")} />
        <div class="bio-grid">
          <div class="bio-text">
            <p>{t("about", "bio_1")}</p>
            <p>{t("about", "bio_2")}</p>
            <p>{t("about", "bio_3")}</p>
          </div>

          <dl
            class="bio-card"
            lang="en"
            translate="no"
            aria-label="Personal stats"
          >
            <div class="bio-card-title" aria-hidden="true">
              <span>{personalData.fileName}</span>
              <span>{byteSize} B</span>
            </div>

            {
              Object.entries(personalData.fileData).map(([key, value]) => (
                <div class="bio-stat">
                  <dt class="bio-stat-key">"{key}"</dt>
                  <dd class="bio-stat-value">{formatValue(value)}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>

      <section class="about-section" aria-label={t("about", "section_journey")}>
        <SectionLabel label={t("about", "section_journey")} />

        <p class="lead about-journey-intro">
          {t("about", "journey_intro")}
        </p>
        <CareerTimeline lang={lang} />
      </section>

      <section class="about-section" aria-label={t("about", "section_skills")}>
        <SectionLabel label={t("about", "section_skills")} />

        <div class="skills-grid">
          {
            skillGroups.map((group) => (
              <div class="skill-card">
                <p class="skill-card-label">{group.label}</p>
                <ul class="skill-list">
                  {group.items.map((item) => (
                    <li
                      class:list={["skill-item", { learning: group.learning }]}
                      translate="no"
                    >
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <section
        class="about-section"
        aria-label={t("about", "section_interests")}
      >
        <SectionLabel label={t("about", "section_interests")} />

        <p class="lead about-interests-intro">
          {t("about", "interests_text")}
        </p>
        <ul class="interests-list">
          {
            interests.map((item) => (
              <li class="interest-tag" translate="no">
                {item}
              </li>
            ))
          }
        </ul>
      </section>

      <section
        class="about-section about-cta"
        aria-labelledby="contact-cta-label"
      >
        <div class="about-cta-text">
          <StatusPill
            variant="success"
            class="about-cta-status"
            ariaLabel={work.isEmployed
              ? work.statusLabel[lang]
              : "Status: open to work"}
          >
            {work.isEmployed ? work.statusKey : t("contact", "open_to")}
          </StatusPill>
          <p id="contact-cta-label">{t("about", "contact_text")}</p>
        </div>
        <Button
          href={localizePath("/contact", lang)}
          variant="primary"
          size="lg"
          title={t("about", "contact_button")}
          class="right-arrow"
        >
          {t("about", "contact_button")}
        </Button>
      </section>

      <section
        class="about-section about-cta"
        aria-labelledby="sponsor-label"
      >
        <div class="about-cta-text">
          <StatusPill variant="accent" class="about-cta-status">
            {t("about", "open_source")}
          </StatusPill>
          <p id="sponsor-label">{t("about", "sponsor_text")}</p>
        </div>
        <Button
          href={profile.sponsorUrl}
          variant="primary"
          size="lg"
          title="Sponsor on GitHub"
          target="_blank"
          class="up-right-arrow"
        >
          ❤️ Sponsor
        </Button>
      </section>
    </article>
  </PageShell>
</Layout>
