---
import PageCommand from "@/components/ui/PageCommand.astro";
import Layout from "../layouts/Layout.astro";
import { getLang, useTranslations, localizePath } from "@/i18n/utils";
import { profile } from "@/data/profile";
import Button from "@ui/Button.astro";

const lang = getLang(Astro);
const t = useTranslations(lang);

// Yetenekler ve ilgi alanları TEK KAYNAK'tan (profile.ts) gelir.
const skills = profile.skills;
const interests = profile.interests;
const work = profile.work;
---

<style>
  .about-page {
    max-width: 100%;
    width: 100%;
    margin-inline: auto;
    padding: 64px 16px;
  }

  .about-page-wrapper {
    max-width: 1024px;
    margin-inline: auto;
  }

  .about-hero {
    margin-bottom: 72px;
  }

  .about-hero-title {
    font-size: clamp(2.2rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 12px;
    color: var(--color-text-primary);
  }
  .about-hero-title .dot {
    color: var(--color-accent);
  }

  .about-hero-subtitle {
    font-family: ui-monospace, monospace;
    font-size: 1rem;
    color: var(--color-accent);
    margin: 0;
    opacity: 0.9;
  }

  /* Decorative terminal prompt — CSS only so reader mode ignores it */
  .about-hero-subtitle::before {
    content: "> ";
  }

  .about-section {
    margin-bottom: 64px;
    animation: fadeUp 0.5s ease both;
  }
  .about-section:nth-child(2) {
    animation-delay: 0.05s;
  }
  .about-section:nth-child(3) {
    animation-delay: 0.1s;
  }
  .about-section:nth-child(4) {
    animation-delay: 0.15s;
  }
  .about-section:nth-child(5) {
    animation-delay: 0.2s;
  }
  .about-section:nth-child(6) {
    animation-delay: 0.25s;
  }

  .sponsor-section {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 64px;
    animation: fadeUp 0.5s ease both;
    padding: 32px;
    background: var(--color-glass-bg);
    border: 1px solid var(--color-glass-border);
    border-radius: 20px;
    filter: drop-shadow(0 8px 32px rgba(0, 0, 0, 0.15));
  }

  /*
   * section-label is now an <h2> for proper heading hierarchy.
   * Reader mode picks it up as a section title; the decorative "#" prefix
   * stays CSS-only so it is stripped in reader mode.
   */
  .section-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5ch;
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    letter-spacing: 0.08em;
    text-transform: lowercase;
    margin-bottom: 24px;
    padding: 5px 12px;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    /* Reset <h2> browser defaults */
    font-weight: normal;
  }
  .section-label::before {
    content: "#";
    color: var(--color-accent);
    font-weight: 600;
  }

  .bio-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  .bio-text p {
    font-size: clamp(1rem, 2vw, 1.1rem);
    line-height: 1.75;
    margin-bottom: 16px;
  }
  .bio-text p:last-child {
    margin-bottom: 0;
  }

  /*
   * bio-card is now a <dl> for semantic key/value pairs.
   * Reader mode renders <dl>/<dt>/<dd> as structured text;
   * visually it looks identical to before.
   */
  .bio-card {
    background: var(--color-glass-bg);
    border: 1px solid var(--color-glass-border);
    border-radius: 16px;
    padding: 24px;
    font-family: ui-monospace, monospace;
    font-size: 0.85rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    align-self: start;
    filter: drop-shadow(0 8px 24px rgba(0, 0, 0, 0.15));
    /* Reset <dl> browser defaults */
    margin: 0;
  }
  .bio-card-title {
    display: flex;
    justify-content: space-between;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    color: var(--color-text-secondary);
    margin-bottom: 12px;
    opacity: 0.7;
  }
  .bio-stat {
    display: flex;
    justify-content: space-between;
    padding: 6px 0;
    border-bottom: 1px solid var(--color-border);
    /* Reset <div> wrapper inside <dl> */
    margin: 0;
  }
  .bio-stat:last-child {
    border-bottom: none;
  }
  .bio-stat-key {
    color: #89b4fa;
    /* Reset <dt> browser defaults */
    font-weight: normal;
  }
  .bio-stat-value {
    color: #a6e3a1;
    text-align: right;
    max-width: 55%;
    /* Reset <dd> browser defaults */
    margin: 0;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    grid-auto-rows: 1fr;
    gap: 16px;
  }
  .skill-card {
    background: var(--color-glass-bg);
    border: 1px solid var(--color-glass-border);
    border-radius: 16px;
    padding: 20px 24px;
    filter: drop-shadow(0 4px 16px rgba(0, 0, 0, 0.1));
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }
  .skill-card:hover {
    transform: translateY(-2px);
    border-color: rgba(var(--color-accent-rgb), 0.4);
  }
  .skill-card-label {
    font-family: ui-monospace, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 12px;
    opacity: 0.9;
  }
  .skill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .skill-item {
    font-family: ui-monospace, monospace;
    font-size: 0.8rem;
    padding: 3px 10px;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }
  .skill-item.learning {
    border-color: rgba(var(--color-accent-rgb), 0.5);
    color: var(--color-accent);
    background: rgba(var(--color-accent-rgb), 0.06);
  }

  .interests-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .interest-tag {
    font-family: ui-monospace, monospace;
    font-size: 0.85rem;
    padding: 6px 14px;
    background: var(--color-glass-bg);
    border: 1px solid var(--color-glass-border);
    border-radius: 8px;
    color: var(--color-text-secondary);
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }
  .interest-tag:hover {
    border-color: rgba(var(--color-accent-rgb), 0.4);
    color: var(--color-text-primary);
  }
  /* Decorative comment prefix — CSS only so reader mode ignores it */
  .interest-tag::before {
    content: "// ";
    color: var(--color-accent);
    opacity: 0.7;
  }

  .about-cta {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 32px;
    background: var(--color-glass-bg);
    border: 1px solid var(--color-glass-border);
    border-radius: 20px;
    filter: drop-shadow(0 8px 32px rgba(0, 0, 0, 0.15));
  }
  .about-cta-text {
    flex: 1;
  }
  .about-cta-text p {
    margin: 0;
    font-size: 1rem;
  }

  .about-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    color: var(--color-code-green-text);
    background: var(--color-code-green-background);
    border: 1px solid var(--color-code-green-border);
    border-radius: 20px;
    padding: 4px 12px;
    margin-bottom: 8px;
  }
  .about-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 6px currentColor;
    flex-shrink: 0;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 700px) {
    .bio-grid {
      grid-template-columns: 1fr;
    }
    .about-cta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<Layout title={t("about", "meta_title")} description={t("about", "meta_desc")}>
  <div class="about-page">
    <!--
      <article> signals to reader mode parsers (Firefox, Safari, etc.)
      that this is the primary readable content of the page.
    -->
    <article class="about-page-wrapper">
      <header class="about-hero">
        <!-- PageCommand is a decorative UI element; aria-hidden keeps it out of the a11y tree -->
        <PageCommand
          pageTitle={t("about", "hero_title")}
          command="whoami"
          aria-hidden="true"
        />

        <h1 class="about-hero-title">
          {t("about", "hero_title")}<span class="dot" aria-hidden="true">.</span
          >
        </h1>
        <!--
          The "> " prompt is now a CSS ::before — reader mode strips CSS,
          so it shows only the meaningful subtitle text.
        -->
        <p class="about-hero-subtitle">{t("about", "hero_subtitle")}</p>
      </header>

      <!--
        section-label is now an <h2> instead of an aria-hidden div.
        Previously: aria-labelledby pointed to an aria-hidden element (invalid).
        Now: the <h2> is visible to both the a11y tree and reader mode,
        giving each section a proper title.
      -->
      <section class="about-section" aria-labelledby="whoami-label">
        <h2 class="section-label" id="whoami-label">
          {t("about", "section_whoami")}
        </h2>
        <div class="bio-grid">
          <div class="bio-text">
            <p>{t("about", "bio_1")}</p>
            <p>{t("about", "bio_2")}</p>
            <p>{t("about", "bio_3")}</p>
          </div>
          <!--
            bio-card is now a <dl> (description list) — the correct semantic
            element for key/value pairs. Reader mode renders <dt>/<dd> as
            structured text instead of a blob of colored spans.
            The decorative "personal.json" header is aria-hidden since it
            adds no real information.
          -->
          <dl
            class="bio-card"
            lang="en"
            translate="no"
            aria-label="Personal stats"
          >
            <div class="bio-card-title" aria-hidden="true">
              <span>personal.json</span>
              <span>156 B</span>
            </div>
            <div class="bio-stat">
              <dt class="bio-stat-key">"name"</dt>
              <dd class="bio-stat-value">"{profile.name}"</dd>
            </div>
            <div class="bio-stat">
              <dt class="bio-stat-key">"location"</dt>
              <dd class="bio-stat-value">"Istanbul, 🇹🇷"</dd>
            </div>
            <div class="bio-stat">
              <dt class="bio-stat-key">"role"</dt>
              <dd class="bio-stat-value">"Dev & Designer"</dd>
            </div>
            <div class="bio-stat">
              <dt class="bio-stat-key">"languages"</dt>
              <dd class="bio-stat-value">["tr", "en"]</dd>
            </div>
            {
              work.isEmployed ? (
                <div class="bio-stat">
                  <dt class="bio-stat-key">"works_at"</dt>
                  <dd class="bio-stat-value">"{work.employer}"</dd>
                </div>
              ) : (
                <div class="bio-stat">
                  <dt class="bio-stat-key">"open_to_work"</dt>
                  <dd class="bio-stat-value">true</dd>
                </div>
              )
            }
          </dl>
        </div>
      </section>

      <section class="about-section" aria-labelledby="skills-label">
        <h2 class="section-label" id="skills-label">
          {t("about", "section_skills")}
        </h2>
        <div class="skills-grid">
          <div class="skill-card">
            <p class="skill-card-label">{t("about", "skills_languages")}</p>
            <ul class="skill-list">
              {
                skills.languages.map((s) => (
                  <li class="skill-item" translate="no">
                    {s}
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="skill-card">
            <p class="skill-card-label">{t("about", "skills_frameworks")}</p>
            <ul class="skill-list">
              {
                skills.frameworks.map((s) => (
                  <li class="skill-item" translate="no">
                    {s}
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="skill-card">
            <p class="skill-card-label">{t("about", "skills_tools")}</p>
            <ul class="skill-list">
              {
                skills.tools.map((s) => (
                  <li class="skill-item" translate="no">
                    {s}
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="skill-card">
            <p class="skill-card-label">{t("about", "skills_learning")}</p>
            <ul class="skill-list">
              {
                skills.learning.map((s) => (
                  <li class="skill-item learning" translate="no">
                    {s}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </section>

      <section class="about-section" aria-labelledby="interests-label">
        <h2 class="section-label" id="interests-label">
          {t("about", "section_interests")}
        </h2>
        <p class="lead" style="margin-bottom: 20px;">
          {t("about", "interests_text")}
        </p>
        <ul class="interests-list">
          {
            interests.map((item) => (
              <li class="interest-tag" translate="no">
                {item}
              </li>
            ))
          }
        </ul>
      </section>

      <section
        class="about-section about-cta"
        aria-labelledby="contact-cta-label"
      >
        <div class="about-cta-text">
          <div
            class="about-status"
            aria-label={work.isEmployed
              ? work.statusLabel[lang]
              : "Status: open to work"}
          >
            <span class="about-status-dot" aria-hidden="true"></span>
            {work.isEmployed ? work.statusKey : t("contact", "open_to")}
          </div>
          <p id="contact-cta-label">{t("about", "contact_text")}</p>
        </div>
        <Button
          href={localizePath("/contact", lang)}
          variant="primary"
          size="lg"
          title={t("about", "contact_button_title")}
        >
          {t("about", "contact_button")}
        </Button>
      </section>

      <section
        class="about-section about-cta sponsor-section"
        aria-labelledby="sponsor-label"
      >
        <div class="about-cta-text">
          <div
            class="about-status"
            style="color: var(--color-accent); background: rgba(var(--color-accent-rgb), 0.08); border-color: rgba(var(--color-accent-rgb), 0.3);"
          >
            <span
              class="about-status-dot"
              aria-hidden="true"
              style="background: var(--color-accent); box-shadow: 0 0 6px var(--color-accent);"
            ></span>
            {t("about", "open_source")}
          </div>
          <p id="sponsor-label" style="margin: 0; font-size: 1rem;">
            {t("about", "sponsor_text")}
          </p>
        </div>
        <Button
          href="https://github.com/sponsors/nazimcanislam"
          variant="primary"
          size="lg"
          title="Sponsor on GitHub"
          target="_blank"
        >
          ❤️ Sponsor
        </Button>
      </section>
    </article>
  </div>
</Layout>
