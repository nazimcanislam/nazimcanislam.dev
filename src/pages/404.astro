---
import Button from "@ui/Button.astro";
import Layout from "@/layouts/Layout.astro";
import PageShell from "@layout/PageShell.astro";
import VoidSvg from "@assets/svg/undraw_void_wez2.svg";
import { getLang, useTranslations, localizePath } from "@i18n/utils";

const lang = getLang(Astro);
const t = useTranslations(lang);
---

<Layout title={t("404", "title")}>
  <PageShell>
    <div class="text-center">
      <VoidSvg width={300} height={200} />
      <h1 class="h1 mt-lg mb-lg">{t("404", "title")}</h1>
      <p class="lead mb-lg">
        {t("404", "desc")}
      </p>
      <Button href={localizePath("/", lang)} class="right-arrow">
        {t("404", "return_home")}
      </Button>
    </div>
  </PageShell>
</Layout>
