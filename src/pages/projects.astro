---
import "@styles/pages/projects.css";
import Layout from "@/layouts/Layout.astro";
import PageShell from "@layout/PageShell.astro";
import SectionHeader from "@layout/SectionHeader.astro";
import SectionLabel from "@ui/SectionLabel.astro";
import { profile } from "@data/profile";
import { getLang, useTranslations } from "@i18n/utils";
import { getLanguageColor } from "@constants/language-colors";
import {
  fetchPublicReposWithLanguageStats,
  formatPct,
} from "@services/github";

const lang = getLang(Astro);
const t = useTranslations(lang);
const professionalProjects = profile.professionalProjects;

const { repos, languageStats, fetchError } =
  await fetchPublicReposWithLanguageStats(
    profile.githubUsername,
    import.meta.env.GITHUB_TOKEN,
  );

const showLangBar = !fetchError && languageStats.length > 0;
---

<Layout
  title={t("projects", "meta_title")}
  description={t("projects", "meta_desc")}
>
  <PageShell>
    <SectionHeader
      dirName={t("projects", "hero_label")}
      pageHeading={t("projects", "hero_title")}
      subHeading={t("projects", "hero_subtitle")}
      command="ls -la"
    />

    {
      professionalProjects.length > 0 && (
        <section class="professional-section">
          <SectionLabel label={t("projects", "professional_section_title")} />

          <ul class="repos-grid">
            {professionalProjects.map((p, i) => (
              <li style={`animation-delay: ${100 * i + 1}ms;`}>
                <a
                  href={p.url}
                  class="repo-card"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${p.name} — ${p.description[lang]}`}
                >
                  <h2 class="repo-name">{p.name}</h2>
                  <p class="repo-desc">{p.description[lang]}</p>
                  <div class="repo-topics" aria-hidden="true">
                    <span class="tag-pill">{p.org[lang]}</span>
                    {p.tags.map((tag) => (
                      <span class="tag-pill">{tag}</span>
                    ))}
                  </div>
                  <div class="repo-meta" aria-hidden="true">
                    <span class="repo-stat">
                      {t("projects", "view_live")} ↗
                    </span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
          <p class="professional-note">
            {t("projects", "professional_source_note")}
          </p>
        </section>
      )
    }

    <SectionLabel label={t("projects", "section_title")} />

    {
      showLangBar && (
        <section
          class="lang-panel"
          data-lang-filter-root
          data-label-projects={t("projects", "count_word")}
          data-label-all={t("projects", "filter_all")}
        >
          <p class="lang-panel-no-js">
            <span>⚠️</span>
            {t("projects", "lang_dist_no_js")}
          </p>

          <div class="lang-panel-head">
            <p class="lang-panel-title">{t("projects", "lang_dist_label")}</p>
            <span class="lang-panel-total">
              {languageStats.length} {t("projects", "languages_word")}
            </span>
          </div>

          <div class="lang-bar" role="presentation" aria-hidden="true">
            {languageStats.map((s) => (
              <span
                class="lang-bar-segment"
                data-lang={s.name}
                title={`${s.name} — ${formatPct(s.pct, lang)}%`}
                style={`--seg-color: ${s.color}; flex-grow: ${s.pct};`}
              />
            ))}
          </div>

          <div
            class="lang-legend"
            role="group"
            aria-label={t("projects", "filter_by_lang")}
          >
            <button
              type="button"
              class="lang-chip lang-chip-all is-active"
              data-lang-filter="*"
              aria-pressed="true"
            >
              {t("projects", "filter_all")}
            </button>
            {languageStats.map((s) => (
              <button
                type="button"
                class="lang-chip lang-pill"
                data-lang-filter={s.name}
                aria-pressed="false"
              >
                <span
                  class="lang-chip-dot"
                  style={`--dot-color: ${s.color};`}
                  aria-hidden="true"
                />
                <span translate="no">{s.name}</span>
                <span class="lang-chip-pct">{formatPct(s.pct, lang)}%</span>
              </button>
            ))}
          </div>

          <p
            class="visually-hidden"
            id="filter-status"
            role="status"
            aria-live="polite"
          />
        </section>
      )
    }

    {
      fetchError ? (
        <div class="error-state">
          <p>{t("projects", "error")}</p>
          <a
            href={profile.socialUrls.github}
            target="_blank"
            rel="noopener noreferrer"
          >
            {profile.social.github}
          </a>
        </div>
      ) : repos.length === 0 ? (
        <div class="empty-state">{t("projects", "loading")}</div>
      ) : (
        <>
          <ul class="repos-grid" data-repo-filter-grid>
            {repos.map((repo, i) => (
              <li
                data-languages={repo.languages.join("|")}
                style={`animation-delay: ${100 * i + 1}ms;`}
              >
                <a
                  href={repo.html_url}
                  class="repo-card"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${repo.name} — ${repo.description ?? t("projects", "no_desc")}`}
                  translate="no"
                >
                  <h2 class="repo-name">{repo.name}</h2>
                  <p class="repo-desc">
                    {repo.description ?? t("projects", "no_desc")}
                  </p>
                  {repo.topics.length > 0 && (
                    <div class="repo-topics" aria-hidden="true">
                      {repo.topics.slice(0, 3).map((topic) => (
                        <span class="tag-pill">{topic}</span>
                      ))}
                    </div>
                  )}
                  <div class="repo-meta" aria-hidden="true">
                    {repo.language && (
                      <span class="repo-lang">
                        <span
                          class="repo-lang-dot"
                          style={`background: ${getLanguageColor(repo.language)}`}
                        />
                        {repo.language}
                      </span>
                    )}
                    {repo.stargazers_count > 0 && (
                      <span
                        class="repo-stat"
                        title={`${repo.stargazers_count} ${t("projects", "stars")}`}
                      >
                        ★ {repo.stargazers_count}
                      </span>
                    )}
                    {repo.forks_count > 0 && (
                      <span
                        class="repo-stat"
                        title={`${repo.forks_count} ${t("projects", "forks")}`}
                      >
                        ⑂ {repo.forks_count}
                      </span>
                    )}
                  </div>
                </a>
              </li>
            ))}
          </ul>
          <p class="filter-empty" data-filter-empty hidden>
            {t("projects", "filter_no_match")}
          </p>
        </>
      )
    }
  </PageShell>
</Layout>

<script>
  import { initLanguageFilter } from "@scripts/pages/projects";
  initLanguageFilter();
</script>
