---
import "@styles/components/section-label.css";
import { slugify } from "@utils/string";

interface Props {
  label: string;
  id?: string;
}

const { label, id = slugify(label) } = Astro.props;
---

<a href={`#${id}`} class="section-label">
  <h2 class="heading" id={id}>
    {label}
  </h2>
</a>
