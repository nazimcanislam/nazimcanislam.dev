---
import "@styles/components/button.css";

interface Props {
  id?: string;
  href?: string;
  variant?: "primary" | "secondary" | "ghost";
  size?: "sm" | "md" | "lg";
  class?: string;
  target?: string;
  singleIcon?: boolean;
  type?: "button" | "submit";
  title?: string;
}

const {
  id,
  href,
  variant = "primary",
  size = "md",
  class: className = "",
  target,
  singleIcon,
  type,
  title,
  ...rest
} = Astro.props;

const isLink = Boolean(href);
const Tag = isLink ? "a" : "button";
---

<Tag
  id={id}
  href={href}
  target={href ? target : undefined}
  type={isLink ? undefined : type}
  rel={isLink && target === "_blank" ? "noopener noreferrer" : undefined}
  class:list={[
    "btn",
    `btn-${variant}`,
    `btn-${size}`,
    className,
    { "single-icon": singleIcon },
  ]}
  title={title}
  {...rest}
>
  <slot />
</Tag>
