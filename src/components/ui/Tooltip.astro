---
import "@styles/components/tooltip.css";

interface Props {
  content: string;
  position?: "top" | "bottom" | "left" | "right";
  delay?: number; // ms
  class?: string;
}

const {
  content,
  position = "top",
  delay = 120,
  class: className,
} = Astro.props;
---

<span
  class:list={["tooltip-wrapper", className]}
  data-position={position}
  style={`--tooltip-delay: ${delay}ms`}
  aria-describedby="tooltip-bubble"
>
  <slot />
  <span class="tooltip-bubble" role="tooltip" aria-hidden="true">
    <span class="tooltip-text">{content}</span>
    <span class="tooltip-arrow"></span>
  </span>
</span>

<script>
  import { initTooltips } from "@scripts/ui/tooltip";
  initTooltips();
</script>
