---
interface Props {
  content: string;
  position?: "top" | "bottom" | "left" | "right";
  delay?: number; // ms
  class?: string;
}

const {
  content,
  position = "top",
  delay = 120,
  class: className,
} = Astro.props;
---

<span
  class:list={["tooltip-wrapper", className]}
  data-position={position}
  style={`--tooltip-delay: ${delay}ms`}
  aria-describedby="tooltip-bubble"
>
  <slot />
  <span class="tooltip-bubble" role="tooltip" aria-hidden="true">
    <span class="tooltip-text">{content}</span>
    <span class="tooltip-arrow"></span>
  </span>
</span>

<style>
  .tooltip-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  /* ── Bubble ── */
  .tooltip-bubble {
    --_gap: 10px;
    --_arrow-size: 6px;
    /* JS overrides these to clamp to viewport */
    --_offset-x: 0px;
    --_offset-y: 0px;

    pointer-events: none;
    position: absolute;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    width: max-content;
    max-width: min(260px, 80vw);

    opacity: 0;
    scale: 0.88;
    transition:
      opacity 0.18s ease,
      scale 0.18s cubic-bezier(0.34, 1.56, 0.64, 1),
      translate 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
    transition-delay: 0s;
  }

  /* ── Text pill ── */
  .tooltip-text {
    display: block;
    padding: 6px 11px;
    border-radius: 8px;
    font-size: 0.78rem;
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: 0.01em;
    text-align: center;
    white-space: normal;
    word-break: break-word;

    color: var(--color-background);
    background: var(--color-text-primary);
    border: 1px solid color-mix(in srgb, var(--color-text-primary) 80%, transparent);
    box-shadow:
      0 4px 16px rgba(0, 0, 0, 0.18),
      0 1px 3px rgba(0, 0, 0, 0.12);
  }

  /* ── Arrow ── */
  .tooltip-arrow {
    position: absolute;
    width: 0;
    height: 0;
    flex-shrink: 0;
  }

  /* ════════════════════════════════
     POSITION VARIANTS
     --_offset-x / --_offset-y are set by JS to clamp within viewport.
     Arrow shifts in the opposite direction so it still points at the trigger.
  ════════════════════════════════ */

  /* TOP */
  .tooltip-wrapper[data-position="top"] .tooltip-bubble {
    bottom: calc(100% + var(--_gap));
    left: 50%;
    translate: calc(-50% + var(--_offset-x)) 6px;
    flex-direction: column;
  }
  .tooltip-wrapper[data-position="top"] .tooltip-arrow {
    top: 100%;
    left: calc(50% - var(--_offset-x));
    translate: -50% 0;
    border-left: var(--_arrow-size) solid transparent;
    border-right: var(--_arrow-size) solid transparent;
    border-top: var(--_arrow-size) solid var(--color-text-primary);
  }

  /* BOTTOM */
  .tooltip-wrapper[data-position="bottom"] .tooltip-bubble {
    top: calc(100% + var(--_gap));
    left: 50%;
    translate: calc(-50% + var(--_offset-x)) -6px;
    flex-direction: column-reverse;
  }
  .tooltip-wrapper[data-position="bottom"] .tooltip-arrow {
    bottom: 100%;
    left: calc(50% - var(--_offset-x));
    translate: -50% 0;
    border-left: var(--_arrow-size) solid transparent;
    border-right: var(--_arrow-size) solid transparent;
    border-bottom: var(--_arrow-size) solid var(--color-text-primary);
  }

  /* LEFT */
  .tooltip-wrapper[data-position="left"] .tooltip-bubble {
    right: calc(100% + var(--_gap));
    top: 50%;
    translate: 6px calc(-50% + var(--_offset-y));
    flex-direction: row;
  }
  .tooltip-wrapper[data-position="left"] .tooltip-arrow {
    left: 100%;
    top: calc(50% - var(--_offset-y));
    translate: 0 -50%;
    border-top: var(--_arrow-size) solid transparent;
    border-bottom: var(--_arrow-size) solid transparent;
    border-left: var(--_arrow-size) solid var(--color-text-primary);
  }

  /* RIGHT */
  .tooltip-wrapper[data-position="right"] .tooltip-bubble {
    left: calc(100% + var(--_gap));
    top: 50%;
    translate: -6px calc(-50% + var(--_offset-y));
    flex-direction: row-reverse;
  }
  .tooltip-wrapper[data-position="right"] .tooltip-arrow {
    right: 100%;
    top: calc(50% - var(--_offset-y));
    translate: 0 -50%;
    border-top: var(--_arrow-size) solid transparent;
    border-bottom: var(--_arrow-size) solid transparent;
    border-right: var(--_arrow-size) solid var(--color-text-primary);
  }

  /* ════════════════════════════════
     VISIBLE STATE
  ════════════════════════════════ */
  .tooltip-wrapper:hover .tooltip-bubble,
  .tooltip-wrapper:focus-within .tooltip-bubble {
    opacity: 1;
    scale: 1;
    transition-delay: var(--tooltip-delay);
  }

  .tooltip-wrapper[data-position="top"]:hover .tooltip-bubble,
  .tooltip-wrapper[data-position="top"]:focus-within .tooltip-bubble {
    translate: calc(-50% + var(--_offset-x)) 0;
  }

  .tooltip-wrapper[data-position="bottom"]:hover .tooltip-bubble,
  .tooltip-wrapper[data-position="bottom"]:focus-within .tooltip-bubble {
    translate: calc(-50% + var(--_offset-x)) 0;
  }

  .tooltip-wrapper[data-position="left"]:hover .tooltip-bubble,
  .tooltip-wrapper[data-position="left"]:focus-within .tooltip-bubble {
    translate: 0 calc(-50% + var(--_offset-y));
  }

  .tooltip-wrapper[data-position="right"]:hover .tooltip-bubble,
  .tooltip-wrapper[data-position="right"]:focus-within .tooltip-bubble {
    translate: 0 calc(-50% + var(--_offset-y));
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .tooltip-bubble {
      transition: opacity 0.1s ease !important;
      scale: 1 !important;
    }
  }
</style>

<script>
  const MARGIN = 8; // min distance from viewport edge (px)

  function clampTooltip(wrapper: HTMLElement) {
    const bubble = wrapper.querySelector<HTMLElement>(".tooltip-bubble");
    if (!bubble) return;

    // Reset offsets first so measurement reflects the unshifted position
    wrapper.style.setProperty("--_offset-x", "0px");
    wrapper.style.setProperty("--_offset-y", "0px");

    // Force reflow so getBoundingClientRect is fresh
    void bubble.offsetWidth;

    const rect = bubble.getBoundingClientRect();
    const vw = window.innerWidth;
    const vh = window.innerHeight;

    let dx = 0;
    let dy = 0;

    if (rect.left < MARGIN) {
      dx = MARGIN - rect.left;
    } else if (rect.right > vw - MARGIN) {
      dx = vw - MARGIN - rect.right;
    }

    if (rect.top < MARGIN) {
      dy = MARGIN - rect.top;
    } else if (rect.bottom > vh - MARGIN) {
      dy = vh - MARGIN - rect.bottom;
    }

    wrapper.style.setProperty("--_offset-x", `${dx}px`);
    wrapper.style.setProperty("--_offset-y", `${dy}px`);
  }

  function initTooltips() {
    document.querySelectorAll<HTMLElement>(".tooltip-wrapper").forEach((wrapper) => {
      const recalc = () => clampTooltip(wrapper);
      wrapper.addEventListener("mouseenter", recalc);
      wrapper.addEventListener("focusin", recalc);
    });
  }

  // View Transitions desteği
  document.addEventListener("astro:page-load", initTooltips);
  initTooltips(); // fallback
</script>
