---
import { getLang, useTranslations, localizePath } from "@/i18n/utils";
import { profile } from "@/data/profile";
import { Icon } from "astro-icon/components";

const lang = getLang(Astro);
const t = useTranslations(lang);

const navCommands = [
  { id: "nav-home", cmd: "home", label: t("nav", "home"), href: localizePath("/", lang), icon: "mdi:home", group: "nav" },
  { id: "nav-about", cmd: "about", label: t("nav", "about"), href: localizePath("/about", lang), icon: "mdi:account", group: "nav" },
  { id: "nav-projects", cmd: "projects", label: t("nav", "projects"), href: localizePath("/projects", lang), icon: "mdi:code-tags", group: "nav" },
  { id: "nav-blog", cmd: "blog", label: t("nav", "blog"), href: localizePath("/blog", lang), icon: "mdi:post", group: "nav" },
  { id: "nav-contact", cmd: "contact", label: t("nav", "contact"), href: localizePath("/contact", lang), icon: "mdi:email", group: "nav" },
];

const terminalCommands = [
  { id: "cmd-whoami", cmd: "whoami", label: lang === "tr" ? "Hakkımda bilgi ve profil özeti" : "Profile summary & bio", icon: "mdi:account-box", group: "cmd" },
  { id: "cmd-skills", cmd: "skills", label: lang === "tr" ? "Yetenekler ve teknoloji yığını" : "List skills & tech stack", icon: "mdi:xml", group: "cmd" },
  { id: "cmd-status", cmd: "status", label: lang === "tr" ? "Sistem ve servis sağlık kontrolü" : "System & services health check", icon: "mdi:pulse", group: "cmd" },
  { id: "cmd-matrix", cmd: "matrix", label: lang === "tr" ? "Matrix dijital yağmur efekti" : "Toggle Matrix digital rain", icon: "mdi:matrix", group: "cmd" },
  { id: "cmd-clear", cmd: "clear", label: lang === "tr" ? "Terminal çıktısını temizle" : "Clear terminal output", icon: "mdi:broom", group: "cmd" },
  { id: "cmd-help", cmd: "help", label: lang === "tr" ? "Tüm komutları listele" : "List available commands", icon: "mdi:help-circle", group: "cmd" },
  { id: "cmd-sudo-rm", cmd: "sudo rm -rf /", label: lang === "tr" ? "⚠️ Root dosya sistemini sil (Easter Egg!)" : "⚠️ Delete root filesystem (Easter Egg!)", icon: "mdi:alert-octagon", group: "cmd", danger: true },
];

const socialCommands = [
  { id: "social-github", cmd: "github", label: "GitHub Profile", href: "https://github.com/nazimcanislam", icon: "mdi:github", external: true, group: "social" },
  { id: "social-linkedin", cmd: "linkedin", label: "LinkedIn Profile", href: "https://linkedin.com/in/nazimcanislam", icon: "mdi:linkedin", external: true, group: "social" },
  { id: "social-email", cmd: "email", label: profile.social.email, href: `mailto:${profile.social.email}`, icon: "mdi:email-outline", group: "social" },
];
---

<style>
  /* Backdrop overlay */
  .cmd-backdrop {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(2, 6, 23, 0.75);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    display: none;
    align-items: flex-start;
    justify-content: center;
    padding: 72px 16px 24px;
    opacity: 0;
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cmd-backdrop.is-open {
    display: flex;
    opacity: 1;
  }

  /* Modal window */
  .cmd-modal {
    position: relative;
    width: 100%;
    max-width: 680px;
    max-height: min(80vh, 640px);
    background: var(--color-glass-bg);
    border: 1px solid var(--color-glass-border);
    border-radius: 16px;
    box-shadow:
      0 24px 64px -12px rgba(0, 0, 0, 0.6),
      0 0 0 1px rgba(var(--color-accent-rgb), 0.15),
      0 0 24px rgba(var(--color-accent-rgb), 0.1);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform: scale(0.96) translateY(-10px);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cmd-backdrop.is-open .cmd-modal {
    transform: scale(1) translateY(0);
  }

  /* Titlebar */
  .cmd-titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    background: rgba(15, 23, 42, 0.4);
    border-bottom: 1px solid var(--color-border);
    user-select: none;
  }

  .cmd-traffic-lights {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .cmd-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    display: inline-block;
  }
  .cmd-dot-red { background: #ed8796; }
  .cmd-dot-yellow { background: #eed49f; }
  .cmd-dot-green { background: #a6da95; }

  .cmd-title {
    font-family: ui-monospace, monospace;
    font-size: 0.78rem;
    color: var(--color-text-secondary);
    letter-spacing: 0.02em;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .cmd-close-hint {
    font-family: ui-monospace, monospace;
    font-size: 0.68rem;
    padding: 2px 7px;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    color: var(--color-text-secondary);
  }

  /* Input area */
  .cmd-input-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--color-border);
    background: rgba(0, 0, 0, 0.15);
  }

  .cmd-prompt {
    font-family: ui-monospace, monospace;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-accent);
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 6px;
    user-select: none;
  }

  .cmd-prompt-sep {
    color: var(--color-code-green-text);
  }

  .cmd-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-family: ui-monospace, monospace;
    font-size: 0.95rem;
    color: var(--color-text-primary);
    caret-color: var(--color-accent);
  }

  .cmd-input::placeholder {
    color: var(--color-text-secondary);
    opacity: 0.7;
    font-size: 0.85rem;
  }

  /* Terminal log output area */
  .cmd-output {
    display: none;
    padding: 16px 18px;
    background: rgba(0, 0, 0, 0.25);
    border-bottom: 1px solid var(--color-border);
    font-family: ui-monospace, monospace;
    font-size: 0.82rem;
    line-height: 1.6;
    max-height: 220px;
    overflow-y: auto;
    color: var(--color-text-primary);
    white-space: pre-wrap;
    word-break: break-word;
  }

  .cmd-output.has-content {
    display: block;
  }

  :global(.cmd-log-command) {
    color: var(--color-accent);
    font-weight: 600;
  }
  :global(.cmd-log-success) {
    color: var(--color-code-green-text);
  }
  :global(.cmd-log-warn) {
    color: #eed49f;
  }
  :global(.cmd-log-error) {
    color: var(--color-code-red-text);
    font-weight: 600;
  }
  :global(.cmd-log-info) {
    color: var(--color-text-secondary);
  }
  :global(.cmd-log-cyan) {
    color: #8bd5ca;
  }

  /* Command lists */
  .cmd-results {
    flex: 1;
    overflow-y: auto;
    padding: 10px 8px;
    list-style: none;
    margin: 0;
  }

  .cmd-group-label {
    padding: 8px 12px 4px;
    font-family: ui-monospace, monospace;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    opacity: 0.8;
  }

  .cmd-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 12px;
    border-radius: 8px;
    cursor: pointer;
    font-family: ui-monospace, monospace;
    font-size: 0.84rem;
    color: var(--color-text-primary);
    transition: background 0.12s ease, transform 0.12s ease;
    user-select: none;
  }

  .cmd-item:hover,
  .cmd-item.is-selected {
    background: rgba(var(--color-accent-rgb), 0.14);
    color: var(--color-accent);
  }

  .cmd-item.danger:hover,
  .cmd-item.danger.is-selected {
    background: rgba(237, 135, 150, 0.18);
    color: #f38ba8;
  }

  .cmd-item-left {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .cmd-item-icon {
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    flex-shrink: 0;
    transition: color 0.12s ease;
  }

  .cmd-item:hover .cmd-item-icon,
  .cmd-item.is-selected .cmd-item-icon {
    color: var(--color-accent);
  }
  .cmd-item.danger:hover .cmd-item-icon,
  .cmd-item.danger.is-selected .cmd-item-icon {
    color: #f38ba8;
  }

  .cmd-item-name {
    font-weight: 600;
    color: var(--color-text-primary);
    flex-shrink: 0;
  }

  .cmd-item.danger .cmd-item-name {
    color: #f38ba8;
  }

  .cmd-item-label {
    color: var(--color-text-secondary);
    font-size: 0.78rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cmd-item-badge {
    font-size: 0.68rem;
    padding: 2px 7px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    flex-shrink: 0;
  }

  .cmd-empty {
    padding: 28px 16px;
    text-align: center;
    font-family: ui-monospace, monospace;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  /* Footer bar */
  .cmd-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 18px;
    background: rgba(15, 23, 42, 0.35);
    border-top: 1px solid var(--color-border);
    font-family: ui-monospace, monospace;
    font-size: 0.72rem;
    color: var(--color-text-secondary);
  }

  .cmd-shortcuts {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .cmd-shortcut-key {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .cmd-shortcut-key kbd {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 1px 5px;
    font-size: 0.65rem;
  }

  /* Softened, Accessible Glitch & Gentle Shake */
  :global(.easter-egg-glitch) {
    transition: filter 0.4s ease, box-shadow 0.4s ease;
    filter: sepia(0.25) hue-rotate(320deg) brightness(0.96);
    box-shadow: inset 0 0 80px rgba(237, 135, 150, 0.22);
    pointer-events: none;
  }

  :global(.easter-egg-shake) {
    animation: gentleShake 0.4s ease-in-out 3;
  }

  @keyframes gentleShake {
    0%, 100% { transform: translate(0, 0); }
    25% { transform: translate(-1.5px, 1px); }
    50% { transform: translate(1.5px, -0.5px); }
    75% { transform: translate(-1px, 0.5px); }
  }

  /* Full accessibility support: respect prefers-reduced-motion */
  @media (prefers-reduced-motion: reduce) {
    :global(.easter-egg-glitch),
    :global(.easter-egg-shake) {
      animation: none !important;
      filter: none !important;
      transform: none !important;
      box-shadow: none !important;
      transition: none !important;
    }
    #matrix-canvas {
      display: none !important;
    }
  }

  /* Fullscreen Matrix Rain Canvas */
  #matrix-canvas {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 9998;
    pointer-events: none;
    display: none;
    opacity: 0.88;
  }

  @media (max-width: 600px) {
    .cmd-backdrop {
      padding: 24px 12px 12px;
    }
    .cmd-item-label {
      display: none;
    }
    .cmd-shortcuts {
      display: none;
    }
  }
</style>

<!-- Matrix Rain Canvas -->
<canvas id="matrix-canvas" aria-hidden="true"></canvas>

<!-- Command Palette Modal -->
<div
  class="cmd-backdrop"
  id="cmd-palette-backdrop"
  role="dialog"
  aria-modal="true"
  aria-label={t("command_palette", "title")}
>
  <div class="cmd-modal" id="cmd-palette-modal">
    <!-- Titlebar -->
    <div class="cmd-titlebar">
      <div class="cmd-traffic-lights">
        <span class="cmd-dot cmd-dot-red" id="cmd-close-btn" title="Close"></span>
        <span class="cmd-dot cmd-dot-yellow" title="Minimize"></span>
        <span class="cmd-dot cmd-dot-green" title="Maximize"></span>
      </div>
      <div class="cmd-title">
        <Icon name="mdi:console" />
        <span>{t("command_palette", "title")}</span>
      </div>
      <span class="cmd-close-hint">ESC</span>
    </div>

    <!-- Input row -->
    <div class="cmd-input-wrap">
      <span class="cmd-prompt">
        <span>~/portfolio</span>
        <span class="cmd-prompt-sep">❯</span>
      </span>
      <input
        type="text"
        id="cmd-palette-input"
        class="cmd-input"
        placeholder={t("command_palette", "placeholder")}
        autocomplete="off"
        spellcheck="false"
        aria-autocomplete="list"
        aria-controls="cmd-palette-list"
      />
    </div>

    <!-- Output terminal logs -->
    <div class="cmd-output" id="cmd-palette-output" role="log" aria-live="polite"></div>

    <!-- Suggestions / Results -->
    <div class="cmd-results" id="cmd-palette-list" role="listbox">
      <!-- Navigation group -->
      <div class="cmd-group" data-group="nav">
        <div class="cmd-group-label">{t("command_palette", "group_navigation")}</div>
        {
          navCommands.map((item) => (
            <div
              class="cmd-item"
              role="option"
              data-cmd={item.cmd}
              data-href={item.href}
              data-label={item.label}
              data-group="nav"
              tabindex="-1"
            >
              <div class="cmd-item-left">
                <Icon name={item.icon} class="cmd-item-icon" />
                <span class="cmd-item-name">{item.cmd}</span>
                <span class="cmd-item-label">{item.label}</span>
              </div>
              <span class="cmd-item-badge">page</span>
            </div>
          ))
        }
      </div>

      <!-- Commands group -->
      <div class="cmd-group" data-group="cmd">
        <div class="cmd-group-label">{t("command_palette", "group_commands")}</div>
        {
          terminalCommands.map((item) => (
            <div
              class="cmd-item"
              class:list={[{ danger: item.danger }]}
              role="option"
              data-cmd={item.cmd}
              data-label={item.label}
              data-group="cmd"
              tabindex="-1"
            >
              <div class="cmd-item-left">
                <Icon name={item.icon} class="cmd-item-icon" />
                <span class="cmd-item-name">{item.cmd}</span>
                <span class="cmd-item-label">{item.label}</span>
              </div>
              <span class="cmd-item-badge">{item.danger ? "danger" : "run"}</span>
            </div>
          ))
        }
      </div>

      <!-- Social / Links group -->
      <div class="cmd-group" data-group="social">
        <div class="cmd-group-label">{t("command_palette", "group_social")}</div>
        {
          socialCommands.map((item) => (
            <div
              class="cmd-item"
              role="option"
              data-cmd={item.cmd}
              data-href={item.href}
              data-label={item.label}
              data-external={item.external ? "true" : "false"}
              data-group="social"
              tabindex="-1"
            >
              <div class="cmd-item-left">
                <Icon name={item.icon} class="cmd-item-icon" />
                <span class="cmd-item-name">{item.cmd}</span>
                <span class="cmd-item-label">{item.label}</span>
              </div>
              <span class="cmd-item-badge">{item.external ? "external ↗" : "link"}</span>
            </div>
          ))
        }
      </div>

      <div class="cmd-empty" id="cmd-empty-msg" hidden>
        {t("command_palette", "no_results")}
      </div>
    </div>

    <!-- Footer bar -->
    <div class="cmd-footer">
      <div class="cmd-shortcuts">
        <span class="cmd-shortcut-key"><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
        <span class="cmd-shortcut-key"><kbd>↵</kbd> select / run</span>
        <span class="cmd-shortcut-key"><kbd>ESC</kbd> close</span>
      </div>
      <span id="cmd-footer-status">● Ready</span>
    </div>
  </div>
</div>

<script>
  import { profile, getAge } from "@/data/profile";

  function setupCommandPalette() {
    const backdrop = document.getElementById("cmd-palette-backdrop");
    const modal = document.getElementById("cmd-palette-modal");
    const input = document.getElementById("cmd-palette-input") as HTMLInputElement | null;
    const output = document.getElementById("cmd-palette-output");
    const list = document.getElementById("cmd-palette-list");
    const emptyMsg = document.getElementById("cmd-empty-msg");
    const closeBtn = document.getElementById("cmd-close-btn");
    const statusText = document.getElementById("cmd-footer-status");
    const matrixCanvas = document.getElementById("matrix-canvas") as HTMLCanvasElement | null;

    if (!backdrop || !input || !output || !list) return;

    let isOpen = false;
    let selectedIndex = 0;
    let matrixAnimationId: number | null = null;
    let isDeletingSystem = false;

    // Get current items visible in DOM
    function getVisibleItems(): HTMLElement[] {
      return Array.from(list!.querySelectorAll<HTMLElement>(".cmd-item:not([hidden])"));
    }

    function updateSelection(items: HTMLElement[], index: number) {
      items.forEach((item, i) => {
        const isSel = i === index;
        item.classList.toggle("is-selected", isSel);
        item.setAttribute("aria-selected", String(isSel));
        if (isSel) {
          item.scrollIntoView({ block: "nearest", behavior: "smooth" });
        }
      });
      selectedIndex = index;
    }

    function openPalette(initialCommand?: string) {
      if (isOpen) {
        if (initialCommand) executeCommand(initialCommand);
        return;
      }
      isOpen = true;
      backdrop!.classList.add("is-open");
      document.body.style.overflow = "hidden";

      input!.value = "";
      filterCommands("");
      setTimeout(() => input!.focus(), 50);

      if (initialCommand) {
        executeCommand(initialCommand);
      }
    }

    function closePalette() {
      if (!isOpen) return;
      isOpen = false;
      backdrop!.classList.remove("is-open");
      document.body.style.overflow = "";
      stopMatrix();
    }

    // Toggle on Ctrl+K / Cmd+K / / / `
    window.addEventListener("keydown", (e) => {
      const isCmdK = (e.ctrlKey || e.metaKey) && (e.key === "k" || e.key === "K");
      const isBacktick = e.key === "`" && !["INPUT", "TEXTAREA"].includes((e.target as HTMLElement)?.tagName);
      const isSlash = e.key === "/" && !["INPUT", "TEXTAREA"].includes((e.target as HTMLElement)?.tagName);

      if (isCmdK || isBacktick || isSlash) {
        e.preventDefault();
        if (isOpen) {
          closePalette();
        } else {
          openPalette();
        }
      } else if (e.key === "Escape" && isOpen) {
        closePalette();
      }
    });

    // Custom event from other buttons (Header / Footer)
    window.addEventListener("open-command-palette", ((e: CustomEvent) => {
      openPalette(e.detail?.runCommand);
    }) as EventListener);

    // Close on backdrop click (outside modal)
    backdrop.addEventListener("click", (e) => {
      if (e.target === backdrop) closePalette();
    });

    closeBtn?.addEventListener("click", closePalette);

    // Filter suggestions
    function filterCommands(query: string) {
      const q = query.trim().toLowerCase();
      const items = Array.from(list!.querySelectorAll<HTMLElement>(".cmd-item"));
      let matchCount = 0;

      items.forEach((item) => {
        const cmd = item.dataset.cmd?.toLowerCase() ?? "";
        const label = item.dataset.label?.toLowerCase() ?? "";
        const matches = q === "" || cmd.includes(q) || label.includes(q);
        item.hidden = !matches;
        if (matches) matchCount++;
      });

      // Update groups visibility
      const groups = Array.from(list!.querySelectorAll<HTMLElement>(".cmd-group"));
      groups.forEach((group) => {
        const hasVisible = group.querySelectorAll(".cmd-item:not([hidden])").length > 0;
        group.hidden = !hasVisible;
      });

      if (emptyMsg) emptyMsg.hidden = matchCount > 0;

      const visible = getVisibleItems();
      updateSelection(visible, 0);
    }

    input.addEventListener("input", () => {
      filterCommands(input.value);
    });

    // Keyboard navigation in palette
    input.addEventListener("keydown", (e) => {
      const visible = getVisibleItems();

      if (e.key === "ArrowDown") {
        e.preventDefault();
        const next = (selectedIndex + 1) % (visible.length || 1);
        updateSelection(visible, next);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        const prev = (selectedIndex - 1 + visible.length) % (visible.length || 1);
        updateSelection(visible, prev);
      } else if (e.key === "Enter") {
        e.preventDefault();
        const typed = input.value.trim();
        if (typed) {
          executeCommand(typed);
        } else if (visible[selectedIndex]) {
          handleItemAction(visible[selectedIndex]);
        }
      }
    });

    // Click on item
    list.addEventListener("click", (e) => {
      const item = (e.target as HTMLElement).closest<HTMLElement>(".cmd-item");
      if (item) handleItemAction(item);
    });

    function handleItemAction(item: HTMLElement) {
      const cmd = item.dataset.cmd;
      const href = item.dataset.href;
      const external = item.dataset.external === "true";

      if (href) {
        if (external) {
          window.open(href, "_blank", "noopener,noreferrer");
          closePalette();
        } else {
          window.location.href = href;
        }
        return;
      }

      if (cmd) {
        executeCommand(cmd);
      }
    }

    function appendOutput(html: string) {
      if (!output) return;
      output.classList.add("has-content");
      output.innerHTML += html + "\n";
      output.scrollTop = output.scrollHeight;
    }

    // ─────────────────────────────────────────────────────────────
    // Command Execution Engine
    // ─────────────────────────────────────────────────────────────
    function executeCommand(rawCmd: string) {
      const cmd = rawCmd.trim();
      if (!cmd) return;

      input!.value = "";
      filterCommands("");

      appendOutput(`<span class="cmd-log-command">$ ${cmd}</span>`);

      const normalized = cmd.toLowerCase();

      // Easter Egg: sudo rm -rf /
      if (
        normalized === "sudo rm -rf /" ||
        normalized === "rm -rf /" ||
        normalized === "sudo rm -rf" ||
        normalized === "rm -rf /*" ||
        normalized === "sudo rm -rf /*"
      ) {
        triggerDestructionEasterEgg();
        return;
      }

      // Matrix
      if (normalized === "matrix") {
        appendOutput(`<span class="cmd-log-success">🟢 Matrix Digital Rain protocol initialized. Press ESC to stop.</span>`);
        startMatrix();
        return;
      }

      // Whoami
      if (normalized === "whoami") {
        appendOutput(
          `<span class="cmd-log-cyan">Name:</span> ${profile.name}\n` +
          `<span class="cmd-log-cyan">Role:</span> ${profile.role.en} / ${profile.role.tr}\n` +
          `<span class="cmd-log-cyan">Age:</span> ${getAge()} years old\n` +
          `<span class="cmd-log-cyan">Location:</span> ${profile.region}\n` +
          `<span class="cmd-log-cyan">Status:</span> ${profile.work.isEmployed ? profile.work.statusLabel.en : "Open to work"}\n` +
          `<span class="cmd-log-info">"I see software development not just as writing code, but as transforming ideas into working systems."</span>`
        );
        return;
      }

      // Skills
      if (normalized === "skills") {
        appendOutput(
          `<span class="cmd-log-success">Languages:</span>  ${profile.skills.languages.join(", ")}\n` +
          `<span class="cmd-log-success">Frameworks:</span> ${profile.skills.frameworks.join(", ")}\n` +
          `<span class="cmd-log-success">Tools & OS:</span> ${profile.skills.tools.join(", ")}\n` +
          `<span class="cmd-log-warn">Learning:</span>   ${profile.skills.learning.join(", ")}`
        );
        return;
      }

      // Status
      if (normalized === "status") {
        appendOutput(
          `<span class="cmd-log-success">● nazimcanislam.dev:</span>       OPERATIONAL (200 OK)\n` +
          `<span class="cmd-log-success">● Vercel Edge Runtime:</span>     ACTIVE (Region: fra1, Latency: 16ms)\n` +
          `<span class="cmd-log-success">● GitHub API Integration:</span>  CONNECTED (Rate-limit: healthy)\n` +
          `<span class="cmd-log-success">● Bubble Canvas Worker:</span>    ONLINE (Multi-threaded OffscreenCanvas)\n` +
          `<span class="cmd-log-cyan">────────────────────────────────────────────</span>\n` +
          `<span class="cmd-log-success">✓ ALL SYSTEMS OPERATIONAL. 0 ERRORS DETECTED.</span>`
        );
        return;
      }

      // Clear
      if (normalized === "clear") {
        output!.innerHTML = "";
        output!.classList.remove("has-content");
        return;
      }

      // Help
      if (normalized === "help") {
        appendOutput(
          `<span class="cmd-log-cyan">Available commands:</span>\n` +
          `  <span class="cmd-log-command">whoami</span>          - Display bio & summary\n` +
          `  <span class="cmd-log-command">skills</span>          - List programming skills & stack\n` +
          `  <span class="cmd-log-command">status</span>          - Inspect system health status\n` +
          `  <span class="cmd-log-command">home / about / projects / blog / contact</span> - Navigation\n` +
          `  <span class="cmd-log-command">matrix</span>          - Start Matrix digital rain\n` +
          `  <span class="cmd-log-command">clear</span>           - Clear terminal window\n` +
          `  <span class="cmd-log-command">sudo rm -rf /</span>   - 🔥 System deletion sequence\n` +
          `  <span class="cmd-log-command">github / linkedin / email</span> - Open links`
        );
        return;
      }

      // Direct navigation aliases
      if (normalized === "home" || normalized === "cd ~" || normalized === "cd") {
        appendOutput(`<span class="cmd-log-info">Navigating to Home...</span>`);
        setTimeout(() => window.location.href = "/", 300);
        return;
      }
      if (normalized === "about" || normalized === "cd about") {
        appendOutput(`<span class="cmd-log-info">Navigating to /about...</span>`);
        setTimeout(() => window.location.href = "/about", 300);
        return;
      }
      if (normalized === "projects" || normalized === "cd projects" || normalized === "ls projects") {
        appendOutput(`<span class="cmd-log-info">Navigating to /projects...</span>`);
        setTimeout(() => window.location.href = "/projects", 300);
        return;
      }
      if (normalized === "blog" || normalized === "cd blog") {
        appendOutput(`<span class="cmd-log-info">Navigating to /blog...</span>`);
        setTimeout(() => window.location.href = "/blog", 300);
        return;
      }
      if (normalized === "contact" || normalized === "cd contact" || normalized === "ping") {
        appendOutput(`<span class="cmd-log-info">Navigating to /contact...</span>`);
        setTimeout(() => window.location.href = "/contact", 300);
        return;
      }
      if (normalized === "github") {
        window.open("https://github.com/nazimcanislam", "_blank");
        return;
      }
      if (normalized === "linkedin") {
        window.open("https://linkedin.com/in/nazimcanislam", "_blank");
        return;
      }
      if (normalized === "email") {
        window.location.href = `mailto:${profile.social.email}`;
        return;
      }

      // Echo
      if (normalized.startsWith("echo ")) {
        appendOutput(cmd.slice(5));
        return;
      }

      // Date
      if (normalized === "date") {
        appendOutput(new Date().toString());
        return;
      }

      // Fallback
      appendOutput(
        `<span class="cmd-log-error">zsh: command not found: ${cmd}</span>\n` +
        `<span class="cmd-log-info">Type <span class="cmd-log-command">help</span> to view all available commands.</span>`
      );
    }

    // ─────────────────────────────────────────────────────────────
    // Easter Egg: The Epic "sudo rm -rf /"
    // ─────────────────────────────────────────────────────────────
    function triggerDestructionEasterEgg() {
      if (isDeletingSystem) return;
      isDeletingSystem = true;

      const steps = [
        { text: `[sudo] password for visitor: *********`, delay: 300, cls: "cmd-log-warn" },
        { text: `⚠️ WARNING: Root deletion sequence initiated!`, delay: 600, cls: "cmd-log-error" },
        { text: `Removing /bin/bash ... [OK]`, delay: 900, cls: "cmd-log-info" },
        { text: `Removing /portfolio/src/layouts ... [OK]`, delay: 1200, cls: "cmd-log-info" },
        { text: `Removing /portfolio/node_modules ... [1.8 GB FREED]`, delay: 1500, cls: "cmd-log-cyan" },
        { text: `Removing /dev/coffee ... ❌ FATAL ERROR: Coffee cannot be removed! Coffee is immortal.`, delay: 1800, cls: "cmd-log-error" },
        { text: `Kernel panic - not syncing: VFS: Unable to mount root fs on unknown-block(0,0)`, delay: 2100, cls: "cmd-log-error" },
      ];

      steps.forEach(({ text, delay, cls }) => {
        setTimeout(() => {
          appendOutput(`<span class="${cls}">${text}</span>`);
        }, delay);
      });

      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // Softened subtle effect (bypassed completely if prefers-reduced-motion is active)
      if (!prefersReducedMotion) {
        setTimeout(() => {
          document.body.classList.add("easter-egg-shake", "easter-egg-glitch");
          if (statusText) statusText.textContent = "⚠️ System Alert";
        }, 2100);
      } else {
        setTimeout(() => {
          appendOutput(`<span class="cmd-log-info">[Notice: Reduced motion active. Visual screen shaking bypassed for comfort.]</span>`);
        }, 2100);
      }

      // Relief / Recovery
      setTimeout(() => {
        if (!prefersReducedMotion) {
          document.body.classList.remove("easter-egg-shake", "easter-egg-glitch");
        }
        appendOutput(
          `\n<span class="cmd-log-cyan">────────────────────────────────────────────</span>\n` +
          `<span class="cmd-log-success">🛡️ Restoring from immutable snapshot...</span>\n` +
          `<span class="cmd-log-success">100% integrity verified.</span>\n` +
          `<span class="cmd-log-success">Just kidding! Nazımcan's architecture is indestructible. 😎</span>\n` +
          `<span class="cmd-log-cyan">────────────────────────────────────────────</span>`
        );
        if (statusText) statusText.textContent = "● System Restored";
        isDeletingSystem = false;
      }, 4000);
    }

    // ─────────────────────────────────────────────────────────────
    // Matrix Rain Effect
    // ─────────────────────────────────────────────────────────────
    function startMatrix() {
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (prefersReducedMotion) {
        appendOutput(`<span class="cmd-log-info">[Notice: Matrix visual rain is disabled because 'prefers-reduced-motion' is active.]</span>`);
        return;
      }
      if (!matrixCanvas) return;
      matrixCanvas.style.display = "block";
      const ctx = matrixCanvas.getContext("2d");
      if (!ctx) return;

      const w = (matrixCanvas.width = window.innerWidth);
      const h = (matrixCanvas.height = window.innerHeight);

      const chars = "ｦｱｳｴｵｶｷｹｺｻｼｽｾｿﾀﾂﾃﾅﾆﾇﾈﾊﾋﾎﾏﾐﾑﾒﾓﾔﾕﾗﾘﾜ1234567890ABCDEF{}[]<>=/\\$*+~#";
      const fontSize = 16;
      const columns = Math.floor(w / fontSize);
      const drops: number[] = Array.from({ length: columns }, () => Math.random() * -50);

      function drawMatrix() {
        ctx!.fillStyle = "rgba(2, 6, 23, 0.08)";
        ctx!.fillRect(0, 0, w, h);

        ctx!.fillStyle = "#38ef7d";
        ctx!.font = `${fontSize}px monospace`;

        for (let i = 0; i < drops.length; i++) {
          const text = chars[Math.floor(Math.random() * chars.length)];
          const x = i * fontSize;
          const y = drops[i] * fontSize;

          // Head of stream is brighter
          ctx!.fillStyle = "#ffffff";
          ctx!.fillText(text, x, y);
          ctx!.fillStyle = "#22c55e";

          if (y > h && Math.random() > 0.975) {
            drops[i] = 0;
          }
          drops[i]++;
        }

        matrixAnimationId = requestAnimationFrame(drawMatrix);
      }

      if (matrixAnimationId) cancelAnimationFrame(matrixAnimationId);
      matrixAnimationId = requestAnimationFrame(drawMatrix);

      // Auto stop after 10s if not stopped
      setTimeout(stopMatrix, 10000);
    }

    function stopMatrix() {
      if (matrixAnimationId) {
        cancelAnimationFrame(matrixAnimationId);
        matrixAnimationId = null;
      }
      if (matrixCanvas) {
        matrixCanvas.style.display = "none";
        const ctx = matrixCanvas.getContext("2d");
        ctx?.clearRect(0, 0, matrixCanvas.width, matrixCanvas.height);
      }
    }
  }

  setupCommandPalette();
</script>
