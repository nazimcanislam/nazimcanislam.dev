---
import { getLang, useTranslations, localizePath } from "@i18n/utils";
import { profile } from "@data/profile";
import { NAV_LINKS } from "@constants/navigation";

const lang = getLang(Astro);
const t = useTranslations(lang);

const navCommands = [
  {
    id: "nav-home",
    cmd: "home",
    label: t("nav", "home"),
    href: localizePath("/", lang),
    icon: "mdi:home",
    group: "nav",
  },
  ...NAV_LINKS.filter((link) => link.href !== "/uses").map((link) => ({
    id: `nav-${link.cmd}`,
    cmd: link.cmd,
    label: t("nav", link.labelKey),
    href: localizePath(link.href, lang),
    icon: link.icon,
    group: "nav",
  })),
];

const terminalCommands = [
  {
    id: "cmd-whoami",
    cmd: "whoami",
    label:
      lang === "tr"
        ? "Hakkımda bilgi ve profil özeti"
        : "Profile summary & bio",
    icon: "mdi:account-box",
    group: "cmd",
  },
  {
    id: "cmd-skills",
    cmd: "skills",
    label:
      lang === "tr"
        ? "Yetenekler ve teknoloji yığını"
        : "List skills & tech stack",
    icon: "mdi:xml",
    group: "cmd",
  },
  {
    id: "cmd-status",
    cmd: "status",
    label:
      lang === "tr"
        ? "Sistem ve servis sağlık kontrolü"
        : "System & services health check",
    icon: "mdi:pulse",
    group: "cmd",
  },
  {
    id: "cmd-matrix",
    cmd: "matrix",
    label:
      lang === "tr"
        ? "Matrix dijital yağmur efekti"
        : "Toggle Matrix digital rain",
    icon: "mdi:matrix",
    group: "cmd",
  },
  {
    id: "cmd-clear",
    cmd: "clear",
    label:
      lang === "tr" ? "Terminal çıktısını temizle" : "Clear terminal output",
    icon: "mdi:broom",
    group: "cmd",
  },
  {
    id: "cmd-help",
    cmd: "help",
    label: lang === "tr" ? "Tüm komutları listele" : "List available commands",
    icon: "mdi:help-circle",
    group: "cmd",
  },
  {
    id: "cmd-sudo-rm",
    cmd: "sudo rm -rf /",
    label:
      lang === "tr"
        ? "⚠️ Root dosya sistemini sil (Easter Egg!)"
        : "⚠️ Delete root filesystem (Easter Egg!)",
    icon: "mdi:alert-octagon",
    group: "cmd",
    danger: true,
  },
];

const socialCommands = [
  {
    id: "social-github",
    cmd: "github",
    label: "GitHub Profile",
    href: profile.socialUrls.github,
    icon: "mdi:github",
    external: true,
    group: "social",
  },
  {
    id: "social-linkedin",
    cmd: "linkedin",
    label: "LinkedIn Profile",
    href: profile.socialUrls.linkedin,
    icon: "mdi:linkedin",
    external: true,
    group: "social",
  },
  {
    id: "social-email",
    cmd: "email",
    label: profile.social.email,
    href: profile.socialUrls.email,
    icon: "mdi:email-outline",
    group: "social",
  },
];

const data = {
  ui: {
    title: t("command_palette", "title"),
    placeholder: t("command_palette", "placeholder"),
    groupNav: t("command_palette", "group_navigation"),
    groupCmd: t("command_palette", "group_commands"),
    groupSocial: t("command_palette", "group_social"),
    noResults: t("command_palette", "no_results"),
  },
  nav: navCommands,
  cmd: terminalCommands,
  social: socialCommands,
};
---

<!--
  Palet modalı HTML'de yer almaz: ilk kullanımda @scripts/palette/index
  (JS + CSS + ikonlar) dinamik import ile yüklenir ve DOM'u kurar.
-->
<script type="application/json" id="cmd-data" set:html={JSON.stringify(data)} />

<script>
  import { initCommandPaletteLoader } from "@scripts/ui/command-palette-loader";
  initCommandPaletteLoader();
</script>
