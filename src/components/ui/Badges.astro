---
import "@styles/components/badges.css";
import type { Badge } from "@/types/badge";

export type { Badge };

interface Props {
  items: Badge[];
}

const { items } = Astro.props;
---

{
  items?.length > 0 && (
    <div class="badges">
      {items.map((badge) => (
        <div
          class={`badge color-${badge.color}${badge.theme ? ` badge-${badge.theme}` : ""}`}
          translate={badge.theme === "tech" ? "no" : "yes"}
        >
          {badge.name}
        </div>
      ))}
    </div>
  )
}
