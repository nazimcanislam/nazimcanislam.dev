---
import "@styles/components/noscript.css";
import { getLang, useTranslations } from "@i18n/utils";

const t = useTranslations(getLang(Astro));
---

<noscript>
  <div class="noscript-warning">
    <p>
      <span class="noscript-icon">&gt;_</span>
      {t("shared", "noscript_message")}
      <span>⚠️</span>
    </p>
  </div>
</noscript>
