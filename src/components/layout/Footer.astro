---
import "@styles/components/footer.css";
import Logo from "@assets/logo.svg";
import {
  getLang,
  useTranslations,
  localizePath,
  stripLocale,
  isActiveRoute,
} from "@i18n/utils";
import { NAV_LINKS, SOCIAL_LINKS } from "@constants/navigation";
import { Icon } from "astro-icon/components";

const lang = getLang(Astro);
const t = useTranslations(lang);
const currentPath = stripLocale(Astro.url.pathname);
const currentYear = new Date().getFullYear();
---

<footer class="site-footer glass" aria-label="Site footer">
  <div class="footer-inner">
    <div class="footer-content">
      <div>
        <a
          href={localizePath("/", lang)}
          class="footer-brand"
          aria-label={t("shared", "logo_title")}
          title={t("shared", "logo_title")}
        >
          <Logo height={40} aria-hidden="true" />
        </a>

        <p class="lead" lang="tr" translate="no">Nazımcan İslam</p>
        <small class="small">{t("meta", "description")}</small>
      </div>

      <nav aria-label="Footer navigation">
        <p class="lead mb-sm">{t("footer", "navigation")}</p>
        <ul class="footer-nav">
          {
            NAV_LINKS.map((link) => {
              const isActive = isActiveRoute(currentPath, link.href);

              return (
                <li>
                  <a
                    href={localizePath(link.href, lang)}
                    class:list={["footer-link", { active: isActive }]}
                    aria-current={isActive ? "page" : null}
                  >
                    {t("nav", link.labelKey)}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>

      <div>
        <p class="lead mb-sm">{t("footer", "social")}</p>
        <ul class="footer-social" aria-label="Social media links">
          {
            SOCIAL_LINKS.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="footer-link"
                  target={link.external ? "_blank" : undefined}
                  rel={link.external ? "noopener noreferrer" : undefined}
                  aria-label={
                    link.external
                      ? `${link.label} (opens in new tab)`
                      : link.label
                  }
                >
                  <Icon name={link.icon} class="link-icon" aria-hidden="true" />
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="footer-bottom-inner">
      <button
        type="button"
        class="system-status-badge"
        id="system-status-btn"
        title={t("footer", "status_tooltip")}
        aria-label={t("footer", "systems_operational")}
      >
        <span class="system-status-dot" aria-hidden="true"></span>
        <span class="system-status-text">
          {t("footer", "systems_operational")}
        </span>
        <span class="system-status-text-no-js">
          {t("footer", "systems_operational_no_js")}
        </span>
      </button>

      <div class="footer-bottom-info">
        <p lang="tr" translate="no">© {currentYear} Nazımcan İslam</p>
        <small class="small">Built with Astro and ❤️</small>
      </div>
    </div>
  </div>
</footer>

<script>
  import { initFooter } from "@scripts/layout/footer";
  initFooter();
</script>
