---
import "@styles/components/section-header.css";
import PageCommand from "@ui/PageCommand.astro";

interface Props {
  dirName: string;
  pageHeading: string;
  subHeading: string;
  command: string;
  largeCommand?: boolean;
}

const { dirName, pageHeading, subHeading, command, largeCommand } = Astro.props;
---

<header class="section-header">
  <PageCommand pageTitle={dirName} command={command} largeText={largeCommand} />

  <h1 class="page-heading">
    {pageHeading}
    <span class="heading-dot" aria-hidden="true">.</span>
  </h1>

  <p class="sub-heading">{subHeading}</p>
</header>
