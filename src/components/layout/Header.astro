---
import "@styles/components/header.css";
import Logo from "@assets/logo.svg";
import { Icon } from "astro-icon/components";
import {
  getLang,
  useTranslations,
  localizePath,
  stripLocale,
  isActiveRoute,
} from "@i18n/utils";
import { NAV_LINKS } from "@constants/navigation";

const lang = getLang(Astro);
const t = useTranslations(lang);
const currentPath = stripLocale(Astro.url.pathname);

const otherLang = lang === "tr" ? "en" : "tr";
const switchHref = localizePath(currentPath, otherLang);
const switchLabel = otherLang === "tr" ? "Türkçe" : "English";
---

<header class="site-header glass">
  <nav class="site-nav" aria-label="Main navigation">
    <a
      href={localizePath("/", lang)}
      class="navbar-brand"
      aria-label={t("shared", "logo_title")}
      title={t("shared", "logo_title")}
    >
      <Logo height={40} aria-hidden="true" />
    </a>

    <!-- Desktop -->
    <ul class="navbar-navs">
      {
        NAV_LINKS.map((link) => {
          const isActive = isActiveRoute(currentPath, link.href);
          return (
            <li>
              <a
                href={localizePath(link.href, lang)}
                class:list={["nav-link", { active: isActive }]}
                aria-current={isActive ? "page" : null}
              >
                {t("nav", link.labelKey)}
              </a>
            </li>
          );
        })
      }
      <li>
        <button
          type="button"
          class="cmd-palette-trigger"
          id="header-cmd-trigger"
          title={lang === "tr"
            ? "Komut Paleti (Ctrl+K)"
            : "Command Palette (Cmd+K)"}
          aria-label={lang === "tr" ? "Komut Paleti" : "Command Palette"}
        >
          <Icon name="mdi:console" class="cmd-icon" aria-hidden="true" />
          <kbd class="cmd-kbd">{lang === "tr" ? "Ctrl K" : "⌘K"}</kbd>
        </button>
      </li>
      <li>
        <a
          href={switchHref}
          class="lang-switch"
          data-set-lang={otherLang}
          hreflang={otherLang}
          aria-label={`${switchLabel} (${otherLang.toUpperCase()})`}
          title={switchLabel}
        >
          {otherLang.toUpperCase()}
        </a>
      </li>
    </ul>

    <!-- Mobile toggle button -->
    <button
      id="navbar-toggle"
      class="navbar-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="navbar-mobile"
      aria-label={t("nav", "menu")}
      title={t("nav", "menu")}
    >
      <Icon
        name="mdi:chevron-down"
        class="navbar-toggle-icon"
        aria-hidden="true"
      />
    </button>
  </nav>

  <!-- Mobile dropdown -->
  <div id="navbar-mobile" class="navbar-mobile" aria-hidden="true">
    <div class="navbar-mobile-inner">
      <a
        href={localizePath("/", lang)}
        class:list={[{ active: isActiveRoute(currentPath, "/") }]}
        aria-current={isActiveRoute(currentPath, "/") ? "page" : null}
      >
        {t("nav", "home")}
      </a>
      {
        NAV_LINKS.map((link) => {
          const isActive = isActiveRoute(currentPath, link.href);
          return (
            <a
              href={localizePath(link.href, lang)}
              class:list={[{ active: isActive }]}
              aria-current={isActive ? "page" : null}
            >
              {t("nav", link.labelKey)}
            </a>
          );
        })
      }

      <div class="navbar-controls">
        <button
          type="button"
          class="cmd-palette-trigger-mobile"
          id="mobile-cmd-trigger"
        >
          <Icon name="mdi:console" class="cmd-icon" aria-hidden="true" />
          <span>Terminal ({lang === "tr" ? "Ctrl+K" : "⌘K"})</span>
        </button>
        <a
          href={switchHref}
          class="lang-switch"
          data-set-lang={otherLang}
          hreflang={otherLang}
          aria-label={`${switchLabel} (${otherLang.toUpperCase()})`}
        >
          {switchLabel} ({otherLang.toUpperCase()})
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  import { initHeader } from "@scripts/layout/header";
  initHeader();
</script>
