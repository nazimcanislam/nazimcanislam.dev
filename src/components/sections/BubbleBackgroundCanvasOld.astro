---
/*
  Mobile-optimized Canvas bubble background
  - No interactive bubble on touch devices
  - Bounded movement (max 20px overflow)
  - Stable mobile performance
*/
---

<canvas id="bubble-canvas"></canvas>

<script>
  const prefersReducedMotion: boolean = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (!prefersReducedMotion) {
    // =========================
    // Global State
    // =========================

    let darkTheme = window.matchMedia("(prefers-color-scheme: dark)").matches;

    const canvas: HTMLCanvasElement = document.getElementById(
      "bubble-canvas",
    ) as HTMLCanvasElement;
    let ctx: CanvasRenderingContext2D | null = canvas?.getContext("2d", {
      alpha: true,
      desynchronized: true,
    });

    if (!ctx) {
      ctx = canvas.getContext("2d");
    }

    if (canvas && ctx) {
      const dpr: number = Math.min(window.devicePixelRatio || 1, 2);
      const MAX_OVERFLOW: number = 20;
      const bubbleCount: number = 8;

      let backgroundGradient: CanvasGradient | null = null;

      const isTouchDevice: boolean =
        "ontouchstart" in window ||
        navigator.maxTouchPoints > 0 ||
        window.matchMedia("(pointer: coarse)").matches;

      // =========================
      // Theme handling
      // =========================

      function updateTheme(isDark: boolean) {
        darkTheme = isDark;
        createBackgroundGradient();
      }

      window
        .matchMedia("(prefers-color-scheme: dark)")
        .addEventListener("change", (e) => {
          updateTheme(e.matches);
        });

      // =========================
      // Resize
      // =========================

      function resize() {
        if (!ctx) return;

        const w: number =
          window.visualViewport?.width || document.documentElement.clientWidth;

        const h: number = window.visualViewport?.height || window.innerHeight;

        canvas.width = w * dpr;
        canvas.height = h * dpr;

        canvas.style.width = w + "px";
        canvas.style.height = h + "px";

        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        createBackgroundGradient();
      }

      let resizeTimeout: number;

      window.addEventListener("resize", () => {
        clearTimeout(resizeTimeout);
        resizeTimeout = window.setTimeout(resize, 150);
      });

      // =========================
      // Background
      // =========================

      function createBackgroundGradient() {
        if (!ctx) return;

        const w: number = canvas.width / dpr;
        const h: number = canvas.height / dpr;

        const bg: CanvasGradient = ctx.createLinearGradient(0, 0, w, h);

        if (darkTheme) {
          bg.addColorStop(0, "#0f172a");
          bg.addColorStop(1, "#020617");
        } else {
          bg.addColorStop(0, "#e5e7eb");
          bg.addColorStop(1, "#ffffff");
        }

        backgroundGradient = bg;
      }

      // =========================
      // Bubble class
      // =========================

      class Bubble {
        x: number;
        y: number;
        r: number;
        phase: number;
        vx: number;
        vy: number;
        color: string;

        constructor(
          x: number,
          y: number,
          r: number,
          color: string,
          speed: number,
        ) {
          this.x = x;
          this.y = y;
          this.r = r;

          this.vx = (Math.random() - 0.5) * speed;
          this.vy = (Math.random() - 0.5) * speed;

          this.color = color;
          this.phase = Math.random() * Math.PI * 2;
        }

        update(w: number, h: number) {
          this.phase += 0.01;

          this.x += this.vx + Math.sin(this.phase) * 0.12;
          this.y += this.vy + Math.cos(this.phase) * 0.12;

          const minX: number = -MAX_OVERFLOW;
          const maxX: number = w + MAX_OVERFLOW;
          const minY: number = -MAX_OVERFLOW;
          const maxY: number = h + MAX_OVERFLOW;

          if (this.x < minX || this.x > maxX) this.vx *= -1;
          if (this.y < minY || this.y > maxY) this.vy *= -1;
        }

        draw(ctx: CanvasRenderingContext2D) {
          const g = ctx.createRadialGradient(
            this.x,
            this.y,
            0,
            this.x,
            this.y,
            this.r,
          );

          g.addColorStop(0, this.color);
          g.addColorStop(1, "transparent");

          ctx.fillStyle = g;

          ctx.beginPath();
          ctx.arc(this.x, this.y, this.r, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      // =========================
      // Setup
      // =========================

      let animation: number;

      let bubbles: Bubble[] = [];

      const colors: string[] = [
        "rgba(18,113,255,0.8)",
        "rgba(221,74,255,0.8)",
        "rgba(100,228,255,0.8)",
        "rgba(200,50,55,0.7)",
        "rgba(100,180,55,0.8)",
      ];

      function getBaseSize() {
        const w = canvas.width / dpr;
        const h = canvas.height / dpr;
        return Math.min(w, h) * 0.18;
      }

      const baseW: number = window.innerWidth;
      const baseH: number = window.innerHeight;

      const BASE_SIZE: number = Math.min(baseW, baseH) * 0.18;

      let interactive: Bubble | null = null;
      let targetScale: number = 1;
      let scale: number = 1;

      if (!isTouchDevice) {
        interactive = new Bubble(
          baseW / 2,
          baseH / 2,
          BASE_SIZE * 1.4,
          "rgba(37,99,235,0.7)",
          0,
        );

        window.addEventListener("pointerdown", () => {
          targetScale = 1.4;
        });

        window.addEventListener("pointerup", () => {
          targetScale = 1;
        });

        window.addEventListener("blur", () => {
          targetScale = 1;
        });
      }

      let targetX: number = baseW / 2;
      let targetY: number = baseH / 2;

      if (!isTouchDevice) {
        window.addEventListener(
          "pointermove",
          (e) => {
            targetX = e.clientX;
            targetY = e.clientY;
          },
          { passive: true },
        );
      }

      // =========================
      // Create bubbles and destroy
      // =========================

      function createBubbles() {
        const w = canvas.width / dpr;
        const h = canvas.height / dpr;

        const baseSize = getBaseSize();

        for (let i = 0; i < bubbleCount; i++) {
          bubbles.push(
            new Bubble(
              Math.random() * w,
              Math.random() * h,
              baseSize * (0.7 + Math.random() * 0.6),
              colors[i % colors.length],
              0.05,
            ),
          );
        }
      }

      function destroyBubbles() {
        bubbles = [];
        ctx?.clearRect(0, 0, canvas.width, canvas.height);
      }

      // =========================
      // Animation
      // =========================

      function animate() {
        if (!ctx) return;

        const w: number = canvas.width / dpr;
        const h: number = canvas.height / dpr;

        ctx.clearRect(0, 0, w, h);

        if (backgroundGradient) {
          ctx.fillStyle = backgroundGradient;
          ctx.fillRect(0, 0, w, h);
        }

        for (const b of bubbles) {
          b.update(w, h);
          b.draw(ctx);
        }

        if (interactive) {
          interactive.x += (targetX - interactive.x) * 0.08;
          interactive.y += (targetY - interactive.y) * 0.08;

          scale += (targetScale - scale) * 0.12;
          interactive.r = getBaseSize() * 1.4 * scale;

          // interactive.update(w, h);
          interactive.draw(ctx);
        }

        animation = requestAnimationFrame(animate);
      }

      // =========================
      // Init
      // =========================

      resize();
      createBubbles();
      createBackgroundGradient();
      animation = requestAnimationFrame(animate);

      window
        .matchMedia("(prefers-reduced-motion: reduce)")
        .addEventListener("change", (event) => {
          if (event.matches) {
            destroyBubbles();
            cancelAnimationFrame(animation);
          } else {
            cancelAnimationFrame(animation);
            animation = requestAnimationFrame(animate);
          }
        });
    }
  }
</script>

<style>
  #bubble-canvas {
    position: fixed;
    inset: 0;

    width: 100%;
    height: 100dvh;

    z-index: -1;
    pointer-events: none;

    transform: translateZ(0);
    will-change: transform;
  }
</style>
