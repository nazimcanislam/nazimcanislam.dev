---
import "@styles/sections/api-explorer.css";
import { getLang, useTranslations, localizePath } from "@i18n/utils";
import { profile, getAge } from "@data/profile";
import Button from "@ui/Button.astro";

const lang = getLang(Astro);
const t = useTranslations(lang);

interface Endpoint {
  method: string;
  path: string;
  key: string;
  response: Record<string, unknown>;
}

const endpoints: Endpoint[] = [
  {
    method: "GET",
    path: "/api/me/personal",
    key: "personal",
    response: {
      name: profile.name,
      birth_year: profile.birth.year,
      age: getAge(),
      gender: profile.gender,
      region: profile.region,
      languages: profile.spokenLanguages,
      role: profile.roleShort.en,
      interests: profile.casualInterests,
    },
  },
  {
    method: "GET",
    path: "/api/me/skills",
    key: "skills",
    response: {
      languages: profile.skills.languages,
      frameworks: profile.skills.frameworks,
      tools: profile.skills.tools,
      currently_learning: profile.skills.learning,
      interested_in: ["compilers", "systems", "open-source"],
    },
  },
  {
    method: "GET",
    path: "/api/me/contact",
    key: "contact",
    response: {
      email: profile.social.email,
      github: profile.social.github,
      linkedin: profile.social.linkedin,
      open_to_dm: true,
    },
  },
];
---

<div class="api-explorer-wrapper">
  <div class="api-explorer" lang="en" translate="no">
    <p class="api-base-url-label">base url</p>
    <div class="api-base-url-badge">
      <span class="api-base-url-dot" role="img" aria-label="Online"></span>
      <span class="api-base-url-text">nazimcanislam.dev</span>
      <span class="api-status-badge no-js">412 Precondition Failed</span>
    </div>

    <div class="api-panel">
      <div class="api-endpoints">
        <p class="api-endpoints-label" id="api-endpoints-label">
          Endpoints
        </p>
        <div
          role="tablist"
          aria-labelledby="api-endpoints-label"
          aria-orientation="vertical"
        >
          {
            endpoints.map((ep, index) => (
              <button
                role="tab"
                id={`tab-${ep.key}`}
                class="api-endpoint-btn"
                aria-selected="false"
                aria-controls={`response-${ep.key}`}
                tabindex={index === 0 ? 0 : -1}
                data-key={ep.key}
                data-response={JSON.stringify(ep.response)}
                type="button"
                title={`Get ${ep.path} endpoint response`}
              >
                <span class="api-method-badge">{ep.method}</span>
                <span class="api-endpoint-path">{ep.path}</span>
              </button>
            ))
          }
        </div>
      </div>

      <div class="api-response" aria-live="polite" aria-atomic="true">
        {
          endpoints.map((ep) => (
            <div
              class="api-response-inner"
              id={`response-${ep.key}`}
              role="tabpanel"
              aria-labelledby={`tab-${ep.key}`}
              tabindex="0"
            >
              <div class="api-response-header">
                <span class="api-response-label">Response body</span>
                <div class="api-response-meta">
                  <span class="api-status-badge" id={`status-${ep.key}`}>
                    <span class="api-status-dot" />
                    <span>200 OK</span>
                  </span>
                  <span class="api-content-type">application/json</span>
                </div>
              </div>
              <div class="api-json-block">
                <pre id={`json-${ep.key}`} />
              </div>
            </div>
          ))
        }

        <div class="api-empty" id="api-empty-state">
          ← select an endpoint
        </div>
        <div class="api-empty no-js">
          Please enable JavaScript to use the API explorer.
        </div>
      </div>
    </div>

    <div class="text-center mt-lg">
      <p class="lead">{t("home_about", "want_learn_more")}</p>
      <Button
        variant="primary"
        size="lg"
        href={localizePath("/about", lang)}
        title={t("home_about", "about_button")}
        class="right-arrow"
      >
        {t("home_about", "about_button")}
      </Button>
    </div>
  </div>
</div>

<script>
  import { initApiExplorer } from "@scripts/sections/api-explorer";
  initApiExplorer();
</script>
