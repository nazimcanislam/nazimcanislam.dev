---
import "@styles/sections/hero.css";
import { getLang, useTranslations, localizePath } from "@i18n/utils";
import { profile } from "@data/profile";
import { Picture } from "astro:assets";
import nazimcanPortrait from "@assets/pictures/nazimcan-anime-avatar.jpg";
import Button from "@ui/Button.astro";
import PageCommand from "@ui/PageCommand.astro";

const lang = getLang(Astro);
const t = useTranslations(lang);

const role = profile.role[lang];
const statusValue = profile.work.isEmployed
  ? `working @ ${profile.work.employer}`
  : "open_to_work";
---

<div class="home-hero">
  <div class="home-hero-content">
    <!-- Image column -->
    <div class="hero-image-col">
      <div class="hero-image-glow" aria-hidden="true"></div>

      <div class="hero-image-frame">
        <Picture
          src={nazimcanPortrait}
          alt="Nazımcan İslam"
          title={t("home", "portrait_title")}
          fetchpriority="high"
          loading="eager"
          widths={[320, 500]}
          sizes="(max-width: 480px) 320px, (max-width: 768px) 500px"
          formats={["avif", "webp"]}
        />
        <div class="hero-scanlines" aria-hidden="true"></div>
        <div class="hero-status-dot" aria-hidden="true"></div>
      </div>

      <div class="hero-status-tag" aria-hidden="true">
        status: <span class="hero-status-tag-value">{statusValue}</span>
      </div>
    </div>

    <!-- Text column -->
    <div class="home-hero-text">
      <PageCommand pageTitle="portfolio" command="whoami" largeText />

      <h1 class="hero-name" translate="no" lang="tr">
        Nazımcan İslam
        <span class="hero-name-dot" aria-hidden="true">.</span>
      </h1>

      <p class="hero-role">
        <span aria-hidden="true">{">"} </span>
        {role}
      </p>

      <p>{t("home", "bio")}</p>

      <div class="hero-buttons-group">
        <Button
          href={localizePath("/projects", lang)}
          size="lg"
          variant="primary"
          title={t("home", "btn_projects_title")}
          class="right-arrow"
        >
          {t("home", "btn_projects")}
        </Button>
        <Button
          href={localizePath("/about", lang)}
          size="lg"
          variant="secondary"
          title={t("home", "btn_about_title")}
          class="right-arrow"
        >
          {t("home", "btn_about")}
        </Button>
      </div>
    </div>
  </div>
</div>
