---
import "@styles/sections/featured-projects.css";
import { getLang, useTranslations, localizePath } from "@i18n/utils";
import { FEATURED_PROJECTS } from "@data/projects";
import Badges from "@ui/Badges.astro";
import Button from "@ui/Button.astro";

const lang = getLang(Astro);
const t = useTranslations(lang);
---

{
  FEATURED_PROJECTS.length > 0 && (
    <section
      class="featured-projects"
      aria-labelledby="featured-projects-title"
    >
      <h2 class="h2 h2--terminal text-center mb-lg" id="featured-projects-title">
        {t("featured_projects", "title")}
      </h2>

      <ul class="projects-grid">
        {FEATURED_PROJECTS.map((project) => {
          const descId = `desc-${project.title.replace(/\s+/g, "-").toLowerCase()}`;
          return (
            <li class="featured-project">
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-describedby={descId}
              >
                <div>
                  <h3 class="mb-md" translate="no" lang="en">
                    {project.title}
                  </h3>
                  <p class="lead" id={descId}>
                    {t(project.description.section, project.description.desc)}
                  </p>
                </div>

                <Badges items={project.tech} />
              </a>
            </li>
          );
        })}
      </ul>

      <div class="text-center mt-lg">
        <p class="lead">{t("featured_projects", "want_learn_projects")}</p>
        <Button
          variant="primary"
          size="lg"
          href={localizePath("/projects", lang)}
          title={t("featured_projects", "want_learn_projects_button")}
          class="right-arrow"
        >
          {t("featured_projects", "want_learn_projects_button")}
        </Button>
      </div>
    </section>
  )
}
