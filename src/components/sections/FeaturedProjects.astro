---

<style>
  .featured-projects {
    padding: 0 16px;
    margin: 48px auto;
    width: 100%;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    column-gap: 16px;
    row-gap: 24px;

    list-style-type: none;
    margin: 0;
    padding: 0;

    max-width: 1024px;
    margin: 0 auto;
  }

  .featured-project {
    display: flex;
    flex-direction: column;
    justify-content: space-between;

    padding: 24px 32px;
    border-radius: 24px;
    height: 100%;

    background: var(--color-glass-bg);
    border: 1px solid var(--color-glass-border);

    filter: drop-shadow(0 8px 32px rgba(0, 0, 0, 0.25));

    transition: transform 0.3s ease;
  }

  .featured-project:hover,
  .featured-project:focus-within {
    transform: translateY(-4px);
  }

  .featured-project a {
    color: var(--color-text-primary);
  }

  .featured-project a:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 6px;
  }

  .featured-project h3 {
    margin-top: 0;
    font-size: clamp(1.3rem, 2.5vw, 1.5rem);
  }

  .featured-project p {
    font-size: clamp(1rem, 2vw, 1.1rem);
  }
</style>

{
  projects.length > 0 && (
    <section
      class="featured-projects"
      aria-labelledby="featured-projects-title"
    >
      <h2
        class="h2 h2--terminal text-center mb-lg"
        id="featured-projects-title"
      >
        {t("featured_projects", "title")}
      </h2>

      <ul class="projects-grid">
        {projects.map((project) => (
          <li class="featured-project">
            <div>
              <h3 class="mb-md" translate="no" lang="en">
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-describedby={`desc-${project.title.replace(/\s+/g, "-").toLowerCase()}`}
                >
                  {project.title}
                </a>
              </h3>
              <p
                class="lead"
                id={`desc-${project.title.replace(/\s+/g, "-").toLowerCase()}`}
              >
                {t(project.description.section, project.description.desc)}
              </p>
            </div>

            <Badges items={project.tech} />
          </li>
        ))}
      </ul>

      <div class="text-center mt-lg">
        <p class="lead">{t("featured_projects", "want_learn_projects")}</p>
        <Button variant="primary" size="lg" href="/projects">
          {t("featured_projects", "want_learn_projects_button")}
        </Button>
      </div>
    </section>
  )
}
