---
import "@styles/sections/career-timeline.css";
import { profile } from "@data/profile";
import { useTranslations } from "@i18n/utils";
import type { Lang } from "@i18n/translations";
import {
  CAREER_KIND_META,
  EMPLOYMENT_LABELS,
  formatCareerDuration,
  formatCareerPeriod,
  resolveCareerEntry,
  sortCareerEntries,
} from "@utils/career";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const presentLabel = t("about", "journey_present");
const nowLabel = t("about", "journey_now");
const entries = sortCareerEntries(profile.career);
---

<ol class="timeline">
  {
    entries.map((entry) => {
      const meta = CAREER_KIND_META[entry.kind];
      const { roles, hasRoles, start, end, current } = resolveCareerEntry(entry);
      const range = formatCareerPeriod(start, end, lang, presentLabel);
      const duration = formatCareerDuration(start, end, lang);

      return (
        <li
          class:list={["t-item", { "is-current": current }]}
          style={`--kind: ${meta.color}`}
        >
          <div class="t-node" aria-hidden="true">
            <span class="t-dot" />
          </div>

          <div class="t-card">
            <div class="t-meta-header">
              <span class="t-kind" translate="no">
                {meta.label[lang]}
              </span>
              {current && (
                <span class="t-now" translate="no">
                  ● {nowLabel}
                </span>
              )}
            </div>

            <div class="t-meta">
              <span class="t-period" translate="no">
                {range}
              </span>
              <span class="t-dur" translate="no">
                · {duration}
              </span>
            </div>

            <h3 class="t-title">
              {hasRoles ? (
                entry.orgUrl ? (
                  <a href={entry.orgUrl} target="_blank" rel="noopener">
                    {(entry.org ?? entry.title)[lang]}
                  </a>
                ) : (
                  (entry.org ?? entry.title)[lang]
                )
              ) : (
                <>
                  {entry.title[lang]}
                  {entry.org && (
                    <span class="t-org" translate="no">
                      {entry.orgUrl ? (
                        <a href={entry.orgUrl} target="_blank" rel="noopener">
                          {entry.org[lang]}
                        </a>
                      ) : (
                        entry.org[lang]
                      )}
                    </span>
                  )}
                </>
              )}
            </h3>

            <p class="t-summary">{entry.summary[lang]}</p>

            {hasRoles && (
              <ol class="t-roles">
                {roles.map((role) => (
                  <li class:list={["t-role", { "is-current": role.current }]}>
                    <div class="t-role-node" aria-hidden="true">
                      <span class="t-role-dot" />
                    </div>
                    <div>
                      <div class="t-role-head">
                        <span class="t-role-title">{role.title[lang]}</span>
                        {role.employment && (
                          <span class="t-emp" translate="no">
                            {EMPLOYMENT_LABELS[role.employment][lang]}
                          </span>
                        )}
                      </div>
                      <div class="t-role-meta" translate="no">
                        {formatCareerPeriod(
                          role.start,
                          role.end,
                          lang,
                          presentLabel,
                        )}{" "}
                        · {formatCareerDuration(role.start, role.end, lang)}
                      </div>
                    </div>
                  </li>
                ))}
              </ol>
            )}

            {entry.tags && entry.tags.length > 0 && (
              <ul class="t-tags">
                {entry.tags.map((tag) => (
                  <li class="t-tag" translate="no">
                    {tag}
                  </li>
                ))}
              </ul>
            )}
          </div>
        </li>
      );
    })
  }
</ol>
